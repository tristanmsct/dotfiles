# Get the file path of the selected item.
# -----------------------------------------------------------------------------------------------------------------------------------------

# The NAUTILUS_SCRIPT_SELECTED_FILE_PATHS variable is set by Nautilus and contains the full path of the selected files.
FULL_PATH="$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"

echo -n $FULL_PATH | wl-copy

dunstify "File's full path copied to clipboard"
