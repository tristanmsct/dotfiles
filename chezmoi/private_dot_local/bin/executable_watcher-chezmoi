#!/usr/bin/env bash
#                _       _                         _                              _
# __      ____ _| |_ ___| |__   ___ _ __       ___| |__   ___ _____ __ ___   ___ (_)
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|____ / __| '_ \ / _ \_  / '_ ` _ \ / _ \| |
#  \ V  V / (_| | || (__| | | |  __/ | |_____| (__| | | |  __// /| | | | | | (_) | |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|        \___|_| |_|\___/___|_| |_| |_|\___/|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

BASELINE_FILE=$HOME/.local/share/system-notes/chezmoi-baseline.txt

if [[ -z $1 ]]; then
	DIFF_OUTPUT=$(diff <(cat $BASELINE_FILE) <(chezmoi unmanaged $HOME))

	NOT_TRACKED=$(echo "$DIFF_OUTPUT" | grep "^>" | sed 's/^> //')

	STATUS_OUTPUT=$(chezmoi status)

	if [[ -z $NOT_TRACKED && -z "$STATUS_OUTPUT" ]]; then
		echo "No changes"
		exit 0
	fi

	if [[ -z $NOT_TRACKED ]]; then
		echo "No new files"
	fi

	if [[ -n $NOT_TRACKED ]]; then
		echo "Not tracked:"
		echo "$NOT_TRACKED"
	fi

	if [ -n "$STATUS_OUTPUT" ]; then
		chezmoi status
	fi
else
	if [[ $1 == "update" ]]; then
		chezmoi unmanaged $HOME > $BASELINE_FILE
	fi
fi
