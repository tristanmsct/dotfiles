#!/usr/bin/env bash
#                _       _                                     __ _
# __      ____ _| |_ ___| |__   ___ _ __       ___ ___  _ __  / _(_) __ _
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|____ / __/ _ \| '_ \| |_| |/ _` |
#  \ V  V / (_| | || (__| | | |  __/ | |_____| (_| (_) | | | |  _| | (_| |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|        \___\___/|_| |_|_| |_|\__, |
#                                                                   |___/
#
# -----------------------------------------------------------------------------------------------------------------------------------------

BASELINE_FILE=$HOME/.local/share/system-notes/config-baseline.txt

if [[ -z $1 ]]; then
	DIFF_OUTPUT=$(diff <(cat $BASELINE_FILE) <(/usr/bin/ls -1 ~/.config/))

	ADDITIONS=$(echo "$DIFF_OUTPUT" | grep "^>" | sed 's/^> //')
	DELETIONS=$(echo "$DIFF_OUTPUT" | grep "^<" | sed 's/^< //')

	if [[ -n $ADDITIONS ]]; then
		echo "Added:"
		echo "$ADDITIONS"
	fi

	if [[ -n $DELETIONS ]]; then
		echo "Deleted:"
		echo "$DELETIONS"
	fi

	if [[ -z $ADDITIONS && -z $DELETIONS ]]; then
		echo "No changes"
	fi
else
	if [[ $1 == "update" ]]; then
		/usr/bin/ls -1 ~/.config/ > $BASELINE_FILE
	fi
fi
