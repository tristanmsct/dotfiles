#!/usr/bin/env python
"""
Package Notes Manager - Track reasons for installed packages

Created on 2026-01-01.

@author: Tristan Muscat
@email: tristan.muscat@pm.me

Usage:
    pkgnote add <package> <reason>
    pkgnote list [package]
    pkgnote remove <package>
    pkgnote search <term>
"""

import subprocess
import json
from pathlib import Path
import sys
import argparse

parser = argparse.ArgumentParser(prog="pkgnote", description="Track reasons for installed packages")
subparsers = parser.add_subparsers(title="Commands", metavar="", dest="command")

parser_add = subparsers.add_parser('add', help='Add a package and its reason', usage="<package> <reason>")
parser_add.add_argument("package", type=str, nargs="?")
parser_add.add_argument("reason", type=str, nargs="?")

parser_list = subparsers.add_parser('list', help='List all or a specific package', usage="<package>")
parser_list.add_argument("package", type=str, nargs="?")

parser_remove = subparsers.add_parser('remove', help='Remove a package', usage="<package>")
parser_remove.add_argument("package", type=str, nargs="?")

parser_search = subparsers.add_parser('search', help='Search for a package or a reason', usage="<term>")
parser_search.add_argument("term", type=str, nargs="?")

NOTES_FILE = Path.home() / ".local/share/system-notes" / "pacman-notes.json"


def load_notes() -> dict:
    """Load notes from JSON file"""
    if not NOTES_FILE.exists():
        return {}
    with open(NOTES_FILE, 'r') as f:
        return json.load(f)


def save_notes(notes: dict):
    """Save notes to JSON file"""
    NOTES_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(NOTES_FILE, 'w') as f:
        json.dump(notes, f, indent=2)


def add_note(package: str, reason: str):
    """Add or update a note for a package"""
    notes = load_notes()

    notes[package] = {
        "reason": reason.strip('"')
    }

    save_notes(notes)
    print(f"✓ Note added for '{package}'")


def list_notes(package: str = None):
    """List notes for a specific package or all packages"""
    notes = load_notes()

    if not notes:
        print("No package notes found.")
        return

    if not package:
        package = subprocess.run(["gum", "choose", "all", *notes.keys(), "exit"], stdout=subprocess.PIPE, text=True).stdout.strip()

        if package in ["", "exit"]:
            print("Action cancelled")
            sys.exit(1)

    if package == "all":
        print("\nPackage Notes:")
        print("-" * 60)
        for pkg, data in sorted(notes.items()):
            print(f"{pkg}:")
            print(f"  {data['reason']}")
            print()
    else:
        if package in notes:
            print(f"\n{package}:")
            print(f"  {notes[package]['reason']}")
        else:
            print(f"No note found for '{package}'")


def remove_note(package):
    """Remove a note for a package"""
    notes = load_notes()
    if not package:
        package = subprocess.run(["gum", "choose", *notes.keys(), "exit"], stdout=subprocess.PIPE, text=True).stdout.strip()

        if package == "exit":
            print("Action cancelled")
            sys.exit(1)

    if package in notes:
        del notes[package]
        save_notes(notes)
        print(f"✓ Note removed for '{package}'")
    else:
        print(f"No note found for '{package}'")


def search_notes(term):
    """Search for a term in package names or reasons"""
    notes = load_notes()
    term_lower = term.lower()

    matches = {
        pkg: data for pkg, data in notes.items()
        if term_lower in pkg.lower() or term_lower in data['reason'].lower()
    }

    if matches:
        print(f"\nSearch results for '{term}':")
        print("-" * 60)
        for pkg, data in sorted(matches.items()):
            print(f"{pkg}:")
            print(f"  {data['reason']}")
            print()
    else:
        print(f"No matches found for '{term}'")


def main():
    args = parser.parse_args()

    blank_start = False
    if not (command := args.command):
        blank_start = True
        command = subprocess.run(["gum", "choose", "add", "list", "remove", "search"], stdout=subprocess.PIPE, text=True).stdout.strip()

    if command == "":
        sys.exit(1)

    if blank_start or all([val is None for key, val in args.__dict__.items() if key != "command"]):
        gum_command = ["gum", "input", f"--prompt=pkgnote {command} ", f"--placeholder={subparsers.choices[command].usage}"]
        arguments = subprocess.run(gum_command, stdout=subprocess.PIPE, text=True).stdout.strip().split(" ", maxsplit=1)

        args = parser.parse_args([command, *arguments])

    if args.command == "add":
        if args.package and args.reason:
            add_note(args.package, args.reason)

    elif args.command == "list":
        if args.package is not None:
            list_notes(args.package)

    elif command == "remove":
        if args.package is not None:
            remove_note(args.package)

    elif command == "search":
        if args.term is not None:
            search_notes(args.term)


if __name__ == "__main__":
    main()
