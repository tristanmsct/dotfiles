#!/usr/bin/env bash
#                _       _
# __      ____ _| |_ ___| |__   ___ _ __
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|
#  \ V  V / (_| | || (__| | | |  __/ |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

WATCHER_DIR="$HOME/.local/bin"

# If no args or help requested
if [[ -z "$1" ]] || [[ "$1" =~ ^(-h|--help|help)$ ]]; then
    echo "watcher - System monitoring toolkit"
    echo
    echo "Available commands:"
    for script in "$WATCHER_DIR"/watcher-*; do
        [[ -x "$script" ]] && basename "$script" | sed 's/^watcher-/  /'
    done
    echo
    echo "Usage: watcher <command> [args]"
    exit 0
fi

# "Open" and "all" commands do not need a stand alone script
if [[ "$1" = "open" ]]; then
    xdg-open $HOME/.local/share/system-notes > /dev/null 2>&1 & disown
    exit 1
elif [[ "$1" = "all" ]]; then
    echo "=== Chezmoi monitored files and directories ==="
    "$WATCHER_DIR/watcher-chezmoi"
    echo

    echo "=== ~/.config directories ==="
    "$WATCHER_DIR/watcher-config"
    echo

    echo "=== .destkop files ==="
    "$WATCHER_DIR/watcher-config"
    echo

    echo "=== AUR custom PKGFILE ==="
    "$WATCHER_DIR/watcher-aur"
    echo

    echo "=== Git repositories ==="
    "$WATCHER_DIR/watcher-git"
    echo

    exit 1
fi

# Dispatch to watcher-<command>
target="$WATCHER_DIR/watcher-$1"

if [[ -x "$target" ]]; then
    shift
    exec "$target" "$@"
else
    echo "Error: watcher-$1 not found"
    echo "Run 'watcher' to see available commands"
    exit 1
fi
