#!/usr/bin/env bash
#                   __ _                                   _ _             
#   ___ ___  _ __  / _(_) __ _       _ __ ___   ___  _ __ (_) |_ ___  _ __ 
#  / __/ _ \| '_ \| |_| |/ _` |_____| '_ ` _ \ / _ \| '_ \| | __/ _ \| '__|
# | (_| (_) | | | |  _| | (_| |_____| | | | | | (_) | | | | | || (_) | |   
#  \___\___/|_| |_|_| |_|\__, |     |_| |_| |_|\___/|_| |_|_|\__\___/|_|   
#                        |___/                                             
# -----------------------------------------------------------------------------------------------------------------------------------------

if [[ -z $1 ]]; then
	DIFF_OUTPUT=$(diff <(cat ~/.config/hypr/scripts/system/config-baseline.txt) <(/usr/bin/ls -1 ~/.config/))
	
	ADDITIONS=$(echo "$DIFF_OUTPUT" | grep "^>" | sed 's/^> //')
	DELETIONS=$(echo "$DIFF_OUTPUT" | grep "^<" | sed 's/^< //')
	
	if [[ -n $ADDITIONS ]]; then
		echo "Added:"
		echo "$ADDITIONS"
	fi
	
	if [[ -n $DELETIONS ]]; then
		echo "Deleted:"
		echo "$DELETIONS"
	fi
	
	if [[ -z $ADDITIONS && -z $DELETIONS ]]; then
		echo "No changes"
	fi
else
	if [[ $1 == "update" ]]; then
		/usr/bin/ls -1 ~/.config/ > ~/.config/hypr/scripts/system/config-baseline.txt
	fi
fi
