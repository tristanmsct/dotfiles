#!/bin/bash
#             _                                   _ _     _
#   __ _  ___| |_      _ __ ___ _ __   ___       | (_)___| |_
#  / _` |/ _ \ __|____| '__/ _ \ '_ \ / _ \ _____| | / __| __|
# | (_| |  __/ ||_____| | |  __/ |_) | (_) |_____| | \__ \ |_
#  \__, |\___|\__|    |_|  \___| .__/ \___/      |_|_|___/\__|
#  |___/                       |_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

# List of repos to check.
# Paths need to be absolute, the ~ notation does not work.

# Main repo, config files and such.
lst_repos=("$HOME/.local/share/dotfiles")

# The main hub for repos.
base_repos="$HOME/Nextcloud/02-Projets/01-Repos"
public_repos="$HOME/Nextcloud/02-Projets/02-Public"

# Add base repos
if [[ -d "$base_repos" ]]; then
    readarray -t base_dirs < <(ls -1d "$base_repos"/*/ 2>/dev/null)
    lst_repos+=("${base_dirs[@]}")
fi

# Add public repos  
if [[ -d "$public_repos" ]]; then
    readarray -t public_dirs < <(ls -1d "$public_repos"/*/ 2>/dev/null)
    lst_repos+=("${public_dirs[@]}")
fi

# Other repos.
lst_repos+=("$HOME/Nextcloud/01-Travail/05-OpenClassrooms/01-Projets"
    "$HOME/Nextcloud/01-Travail/05-OpenClassrooms/98-OCManager")

export lst_repos
