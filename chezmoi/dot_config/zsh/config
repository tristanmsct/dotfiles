# -----------------------------------------------------
# oh-myzsh plugins
# -----------------------------------------------------
plugins=(
    git
    sudo
    web-search
    archlinux
    zsh-autosuggestions
    zsh-syntax-highlighting
    fast-syntax-highlighting
    copyfile
    copybuffer
    dirhistory
)

# -----------------------------------------------------
# Completion Scripts
# -----------------------------------------------------

# Initialize completion system
# /!\ Moving these instructions down can break the config.
fpath=(~/.config/zsh/completions $fpath)
autoload -Uz compinit && compinit -d "$XDG_CACHE_HOME"/zsh/zcompdump-"$ZSH_VERSION"

[[ ! -f $ZDOTDIR/applications/task_completion.zsh ]] || source "$ZDOTDIR/applications/task_completion.zsh"
[[ ! -f $ZDOTDIR/applications/eww_completion.zsh ]] || source "$ZDOTDIR/applications/eww_completion.zsh"
[[ ! -f $ZDOTDIR/applications/glow_completion.zsh ]] || source "$ZDOTDIR/applications/glow_completion.zsh"

# Set-up oh-my-zsh
source $ZSH/oh-my-zsh.sh

# -----------------------------------------------------
# Set-up FZF key bindings (CTRL R for fuzzy history finder)
# -----------------------------------------------------
source <(fzf --zsh)

# -----------------------------------------------------
# Tools
# -----------------------------------------------------
eval "$(pyenv init - zsh)"
eval "$(zoxide init zsh)"
eval "$(thefuck --alias)"
eval "$(ssh-agent)" &>/dev/null

# -----------------------------------------------------
# Terminal Keybinds
# -----------------------------------------------------
bindkey "^?" backward-delete-char    # Backspace deletes a single character
bindkey "^W" backward-kill-word      # Ctrl + W (or remapped Ctrl + Backspace) deletes a word
bindkey '^D' kill-whole-line         # Ctrl + G to clear the line
