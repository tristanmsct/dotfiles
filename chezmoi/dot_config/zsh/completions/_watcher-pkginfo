#compdef watcher-pkginfo

_watcher-pkginfo() {
    local -a options
    options=(
      'save:Save the current state, used as a pacman hook'
      'query:Query the package list (Repo -r, Name -n, Version -v, Installation type -t)'
      'diff:Display the difference between two states (default is last two, -c for choice)'
      'help:Display this help message'
    )

    _describe 'watcher-pkginfo commands' options
}

_watcher-pkginfo "$@"
