#compdef watcher-pkgnotes

_watcher-pkgnotes() {
    local -a options
    options=(
      'add:Add a package and its reason'
      'list:List all or a specific package'
      'remove:Remove a package'
      'search:Search for a package or a reason'
    )

    _describe 'watcher-pkgnotes commands' options
}

_watcher-pkgnotes "$@"
