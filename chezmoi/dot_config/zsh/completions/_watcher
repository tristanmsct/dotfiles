#compdef watcher

_watcher() {
    local -a commands
    local watcher_dir="$HOME/.local/bin"

    case $CURRENT in
        2)
            # First argument: command names
            for script in "$watcher_dir"/watcher-*; do
                [[ -x "$script" ]] || continue
                local cmd=$(basename "$script" | sed 's/^watcher-//')
                local desc=""

                case "$cmd" in
                    desktop) desc="Monitor .desktop file changes" ;;
                    config) desc="Monitor .config directory" ;;
                    git) desc="Check git repositories status" ;;
                    aur) desc="Check for custom AUR packages changes" ;;
                    chezmoi) desc="Track chezmoi-managed files" ;;
                    pkgnotes) desc="Manage package notes" ;;
                    pkginfo) desc="Collect packages information" ;;
                    sysinfo) desc="Collect system information" ;;
                esac

                commands+=("$cmd:$desc")
            done
            commands+=("open:Open the system notes directory")
            _describe 'watcher command' commands
            ;;
        3)
            # Second argument: subcommands based on first arg
            case ${words[2]} in
                desktop)
                    _arguments '2:command:_watcher-desktop'
                    ;;
                config)
                    _arguments '2:command:_watcher-config'
                    ;;
                chezmoi)
                    _arguments '2:command:_watcher-chezmoi'
                    ;;
                pkgnotes)
                    _arguments '2:command:_watcher-pkgnotes'
                    ;;
                pkginfo)
                    _arguments '2:command:_watcher-pkginfo'
                    ;;
            esac
            ;;
    esac
}

_watcher "$@"
