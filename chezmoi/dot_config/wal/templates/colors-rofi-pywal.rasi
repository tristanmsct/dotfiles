    color2-tr: rgba({color2.rgb}, 0.3);
    color3-tr: rgba({color3.rgb}, 0.3);
    color4-tr: rgba({color4.rgb}, 0.3);
    color5-tr: rgba({color5.rgb}, 0.3);
    color6-tr: rgba({color6.rgb}, 0.3);
