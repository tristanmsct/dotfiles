// Configuration --------------------------------------------------------------------------------------------------------------------------
configuration {
    font:                           "MesloLGS NF 16";
    show-icons:                     true;
}

@import "config-base.rasi"

* {
    font:                           "MesloLGS NF 14";
    background-color:               transparent;
    background:                   #1D2330;
    background-transparent:       #1D2330A0;
    text-color:                   #BBBBBB;
    text-color-selected:          #FFFFFF;
    primary:                        @main-color;
    important:                      @main-color;
}

// Window / Mainbox -----------------------------------------------------------------------------------------------------------------------
window {
    fullscreen:                     true;
    height:                         100%;
    width:                          100%;
    transparency:                   "real";
    background-color:               @background-transparent;
    border:                         0px 0px 0px 0px;
    border-radius:                  0;
    border-color:                   @primary;
}

mainbox {
    children:                       [prompt, inputbar-box, listview];
    padding:                        0px 0px;
}

// Search bar -----------------------------------------------------------------------------------------------------------------------------
inputbar {
    children:                       [textbox-prompt, entry];
    margin:                         0px;
    padding:                        0px;
    background-color:               @primary;
    border:                         2px;
    border-color:                   @primary;
    border-radius:                  8px;
}

inputbar-box {
    children:                       [dummy, inputbar, dummy];
    orientation:                    horizontal;
    expand:                         false;
}

entry {
    expand:                         false;
    padding:                        10px;
    margin:                         -6px;
    horizontal-align:               0;
    width:                          300;
    background-color:               @background;
    border:                         6px;
    border-color:                   @primary;
    border-radius:                  8px;
    cursor:                         text;
}

prompt {
    width:                          100%;
    margin:                         10px 0px 0px 30px;
    text-color:                     @important;
    font:                           "MesloLGS NF 34";
}

textbox-prompt {
    text-color:                     @background;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    expand:                         false;
    str:                            "";
    font:                           "MesloLGS NF 24";
    padding:                        0px 10px 0px 5px;
}

// Listview -------------------------------------------------------------------------------------------------------------------------------
listview {
    layout:                         vertical;
    padding:                        60px;
    dynamic:                        true;
    columns:                        7;
    spacing:                        20px;
}

// Elements -------------------------------------------------------------------------------------------------------------------------------
element {
    children:                       [dummy, element-box, dummy];
    padding:                        5px;
    orientation:                    vertical;
    border:                         0px 4px solid 0px 4px;
    border-color:                   transparent;
    border-radius:                  16;
}

element selected {
    border-color:                   @primary;
}

element-box {
    width: 10px;
    children:                       [element-icon, element-text];
    orientation:                    vertical;
    expand:                         false;
    cursor:                         pointer;
}

element-icon {
    border-radius:                  16;
    // padding:                        10px;
    cursor:                         inherit;
    size:                           33%;
    margin:                         5px;
}

element-text {
    padding:                        0px 5px 2px 5px;
    horizontal-align:               0.5;
    cursor:                         inherit;
    text-color: @text-color;
}

element-text selected {
    text-color: @text-color-selected;
}
