// Configuration --------------------------------------------------------------------------------------------------------------------------

configuration {
    modi:                           "drun";
    show-icons:                     true;
	hover-select:                   true;
    display-drun: 					"󰍉";
    drun-display-format:            "{name}";
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}

@import "config-base.rasi"

// Window / Mainbox -----------------------------------------------------------------------------------------------------------------------
window {
    height:                         50%;
    width:                          40%;
    location:                       center;
    x-offset:                       0;
    y-offset:                       0;
    padding:                        0;
}

mainbox {
    background-color:               inherit;
    children:                       [ "inputbar", "listview" ];
    spacing:                       	2%;
    padding:                        1.5%;
}

// Search bar -----------------------------------------------------------------------------------------------------------------------------
inputbar {
	children: 						[ "prompt", "entry" ];
}

entry {
    placeholder:                    "Search Applications";
}

// Listview -------------------------------------------------------------------------------------------------------------------------------
listview {
    columns:                        4;
    spacing:                        1%;
}

// Elements -------------------------------------------------------------------------------------------------------------------------------
element {
    orientation:                    vertical;
    border-radius:                  1%;
    padding:                        2% 0% 2% 0%;
}

element-icon {
    size:                           6%;
    border:                         0;
}

element-text {
    expand:                         true;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    margin:                         0.5% 1% 0% 1%;
}
