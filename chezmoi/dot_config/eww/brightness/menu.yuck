;; Variables
(defvar current-value 50) ; Static variable that won't auto-update
(defvar button-text "Click Me")

; (defvar button-active true)
(defpoll button-active
  :interval "1s"
  :initial true
  "cat /tmp/eww_xpos")
(defvar foo 10)

(defpoll brightness-value :interval "200ms"
  :initial "$(( $(brightnessctl g) * 100 / $(brightnessctl m) ))"
  "echo $(( $(brightnessctl g) * 100 / $(brightnessctl m) ))")

(defpoll sunset-value :interval "200ms"
  :initial "$(hyprctl hyprsunset temperature)"
  "echo $(hyprctl hyprsunset temperature)")

;; Widget Definition
(defwidget brigntness-menu-control []
  (box
    :class "brightness-menu-widget"
    :orientation "v"
    :space-evenly false
    :spacing 15
    :halign "center"
    :valign "center"

    ;; A label
    (label
      :class "birghtness-menu-title"
      :xalign 0.1
      :text "Brightness menu"
    )

    (box
      :orientation "h"
      :space-evenly false
      :spacing 15

      (label
        :class "hello"
        :text "Brightnes"
      )

      ;; Slider
      (box
        :class "slider-container"
        :halign "fill"
        :hexpand true
        (eventbox
          :cursor "pointer"
          (scale
            :class "brightness-slider"
            :min 0
            :max 101
            :timeout 1000
            :value brightness-slider-value
            :onchange "~/.config/eww/brightness/scripts/set_brightness.sh {}"
            :tooltip "Drag to change value (20-100)"
          )
        )
      )
    )

    (box
      :orientation "h"
      :space-evenly false
      :spacing 15

      ;; Button
      (eventbox
        :cursor "pointer"
        (button
          :class "control-button"
          ; :onclick "notify-send 'Button Clicked!' 'Slider value: ${current-value}  Brightness value ${brightness-value}'; eww close mywidget"
          :onclick "hyprctl hyprsunset temperature 6500"
          ; :onclick "dunstify ${button-active}"
          :tooltip "Click to show current slider value"
          "Hyprsunset"
        )
      )

      ;; Slider
      (box
        :class "slider-container"
        :halign "fill"
        :hexpand true
        (eventbox
          :cursor "pointer"
          (scale
            :class "brightness-slider"
            :min 1000
            :max 20000
            :timeout 1000
            :value sunset-value
            ;; :onchange "eww update current-value={} && notify-send 'Slider Changed' 'New value: {}'"
            :onchange "hyprctl hyprsunset temperature {}"
            :tooltip "Drag to change value (0-100)"
          )
        )
      )
    )
    (box
      :orientation "h"
      :space-evenly false
      :spacing 15

      ;; Button
      (eventbox
        :cursor "pointer"
        (button
          :class "control-button"
          :onclick "notify-send 'Button Clicked!' 'Slider value: ${current-value}  Brightness value ${brightness-value}'; eww close mywidget"
          :tooltip "Click to show current slider value"
          "Hyprsunset Auto Timer"
        )
      )
    )

  (box
    "Some math : ${12 + foo * 10}"
    (button
      :class {button-active ? "active" : "inactive"}
      :onclick {button-active ? "eww update button-active=false" : "eww update button-active=true"}
      {button-active ? "disable" : "enable"}
    )
  )

  )
)

;; Window Definition
(defwindow brightness-menu-window
  :monitor 0
  :orientation "v"
  :geometry (geometry
    :x "0"
    :y "0"
    :width "300px"
    ;; :height "150px"
    ; :anchor "center"
    :anchor "top right"
  )
  :stacking "fg"
  :wm-ignore false
  :resizable false
  (box
    :orientation "v"
    :spacing 0
    (brigntness-menu-control)
  )
)
