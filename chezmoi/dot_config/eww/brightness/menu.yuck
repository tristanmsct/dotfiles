;; Variables
(defpoll hyprsunset-active
  :interval "1s"
  :initial "echo $( cat /home/tristan/.config/hypr/conf/hyprsunset.json|jq '.filter_on' )"
  "echo $( cat /home/tristan/.config/hypr/conf/hyprsunset.json|jq '.filter_on' )"
)

(defpoll hyprsunset-timer-active
  :interval "1s"
  :initial "echo $( cat /home/tristan/.config/hypr/conf/hyprsunset.json|jq '.auto_timer' )"
  "echo $( cat /home/tristan/.config/hypr/conf/hyprsunset.json|jq '.auto_timer' )"
)

(defpoll brightness-value
  :interval "200ms"
  :initial  "$(( $(brightnessctl g) * 100 / $(brightnessctl m) ))"
  "$(( $(brightnessctl g) * 100 / $(brightnessctl m) ))"
)

(defpoll keyboard-backlight-value
  :interval "200ms"
  :initial "brightnessctl get -d samsung-galaxybook::kbd_backlight"
  "brightnessctl get -d samsung-galaxybook::kbd_backlight"
)

(defpoll sunset-value
  :interval "200ms"
  :initial "echo $(( $( cat /home/tristan/.config/hypr/conf/hyprsunset.json|jq '.temperature' ) / 50 ))"
  "echo $(( $( cat /home/tristan/.config/hypr/conf/hyprsunset.json|jq '.temperature' ) / 50 ))"
)

;; Widget Definition
(defwidget brigntness-menu-control []
  (box
    :class "brightness-menu-widget"
    :orientation "v"
    :space-evenly false
    :spacing 15
    :halign "center"
    :valign "center"

    ;; Menu title
    (label
      :class "birghtness-menu-title"
      :xalign 0.1
      :text "Brightness menu"
    )

    ;; Group contained brightness elements
    (box
      :orientation "v"
      :class "element-group"

      ;; Monitor brightness slider
      (box
        :orientation "h"
        :space-evenly false
        :spacing 15

        (label
          :class "slider-label"
          :text "Monitor"
        )

        (box
          :class "slider-container"
          :halign "fill"
          :hexpand true
          (eventbox
            :cursor "pointer"
            (scale
              :class "brightness-slider"
              :min 0
              :max 21
              :timeout 1000
              :value brightness-slider-value
              :onchange "~/.config/eww/brightness/scripts/set-brightness.sh $(({} * 5))"
              :tooltip "Drag to change value (20-100)"
            )
          )
        )
      )

      ;; Keyboard brightness slider
      (box
        :orientation "h"
        :space-evenly false
        :spacing 15

        (label
          :class "slider-label"
          :text "Keyboard"
        )

        (box
          :class "slider-container"
          :halign "fill"
          :hexpand true
          (eventbox
            :cursor "pointer"
            (scale
              :class "brightness-slider"
              :min 0
              :max 4
              :timeout 1000
              :value keyboard-backlight-value
              :onchange "brightnessctl set {} -d samsung-galaxybook::kbd_backlight "
              :tooltip "Drag to change value (0-3)"
            )
          )
        )
      )
    )

    ;; Group contained hyprsunset elements
    (box
      :orientation "v"
      :class "element-group"
      :spacing 15

      ;; Hyprsunset elements
      (box
        :orientation "h"
        :space-evenly false
        :spacing 15

        ;; Hyprsunset toggle button
        (eventbox
          :cursor "pointer"
          (button
            :class {hyprsunset-active == "true" ? "control-button-active" : "control-button"}
            :onclick "~/.config/hypr/scripts/hyprsunset/hyprsunset.sh"
            :onrightclick "~/.config/eww/brightness/scripts/menu-hyprsunset-slider.sh 6500"
            :tooltip "Click to toogle hyprsunset manually"
            "Hyprsdunset"
          )
        )

        ;; hyprsunset slider
        (box
          :class "slider-container"
          :halign "fill"
          :hexpand true
          (eventbox
            :cursor "pointer"
            (scale
              :class  {
                        sunset-value < 130 ? "hyprsunset-slider-hot" :
                        sunset-value == 130 ? "hyprsunset-slider" :
                        "hyprsunset-slider-cold"
                      }
              :min 20
              :max 400
              :timeout 1000
              :value sunset-value
              :onchange "~/.config/eww/brightness/scripts/menu-hyprsunset-slider.sh $(({} * 50))"
              :tooltip "Drag to change value (1000 - 20000)"
            )
          )
        )
      )

      ;; Hyprsunset auto timer button
      (box
        :orientation "h"
        :space-evenly true
        :spacing 15

        (eventbox
          :cursor "pointer"
          (button
            :class {hyprsunset-timer-active == "true" ? "control-button-active" : "control-button"}
            :onclick "~/.config/eww/brightness/scripts/menu-hyprsunset-timer-button.sh"
            :tooltip "Click to toogle hyprsunset auto timer"
            "Hyprsunset Auto Timer"
          )
        )
      )
    )

  )
)

;; Brightness window closer
; This is a overlay invisible window over the entire screen that catches clicks and closes both windows when clicked.
(defwindow brightness-menu-window-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "brightness-menu-window")
)

;; Window Definition
(defwindow brightness-menu-window
  :monitor 0
  :orientation "v"
  :geometry (geometry
    :x "0"
    :y "0"
    :width "400px"
    :height "150px"
    :anchor "center"
  )
  :stacking "fg"
  :wm-ignore false
  :resizable false
  (box
    :orientation "v"
    :spacing 0
    (brigntness-menu-control)
  )
)
