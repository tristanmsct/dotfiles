# -----------------------------------------------------
# Prompt
# -----------------------------------------------------
eval "$(oh-my-posh init bash --config $HOME/.config/ohmyposh/zen.toml)"

# -----------------------------------------------------
# Tools
# -----------------------------------------------------
[[ -s /usr/share/autojump/autojump.bash ]] && . /usr/share/autojump/autojump.bash
eval $(thefuck --alias)
eval "$(ssh-agent)" &>/dev/null

# -----------------------------------------------------
# Completion Scripts
# -----------------------------------------------------
[[ ! -f $HOME/.config/shell/completion ]] || source $HOME/.config/shell/completion
[[ ! -f $HOME/.config/bash/task_completion.bash ]] || source $HOME/.config/bash/task_completion.bash
