# -----------------------------------------------------------------------------------------------------------------------------------------
# For a clean home directory.
# https://github.com/b3nj5m1n/xdg-ninja
# -----------------------------------------------------------------------------------------------------------------------------------------

# Misc.
export EDITOR=nano
export PATH="/usr/lib/ccache/bin/:$PATH"

# Main paths for config files and such.
export XDG_CONFIG_HOME="$HOME"/.config
export XDG_CACHE_HOME="$HOME"/.cache
export XDG_DATA_HOME="$HOME"/.local/share
export XDG_STATE_HOME="$HOME"/.local/state
export FAKE_HOME="$XDG_STATE_HOME/fake_home"

export ANSIBLE_HOME="$XDG_DATA_HOME"/ansible
export GOPATH="$XDG_DATA_HOME"/go
export GOTELEMETRYDIR="$XDG_CACHE_HOME"/go-telemetry
export GTK2_RC_FILES="$XDG_CONFIG_HOME"/gtk-2.0/gtkrc
export PYENV_ROOT="$XDG_DATA_HOME"/pyenv
export PYTHONSTARTUP="$XDG_CONFIG_HOME"/python/pythonrc
export IPYTHONDIR="$XDG_CONFIG_HOME"/ipython
export JUPYTER_CONFIG_DIR="$XDG_CONFIG_HOME"/jupyters
export DOCKER_CONFIG="$XDG_CONFIG_HOME"/docker
# export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME"/npm/npmrc
export VSCODE_PORTABLE="$XDG_CONFIG_HOME"/VSCodium
export CARGO_HOME="$XDG_DATA_HOME"/cargo
export RUSTUP_HOME="$XDG_DATA_HOME"/rustup
export GNUPGHOME="$XDG_DATA_HOME"/gnupg
export DOTNET_CLI_HOME="$XDG_DATA_HOME"/dotnet
export NUGET_PACKAGES="$XDG_CACHE_HOME"/NuGetPackages
export SQLITE_HISTORY="$XDG_CACHE_HOME"/sqlite_history

# Shell-specific settings.
if [ -n "$ZSH_VERSION" ]; then
    export ZDOTDIR="$XDG_CONFIG_HOME"/zsh
    export ZSH="$XDG_DATA_HOME"/oh-my-zsh
    export ZSH_COMPDUMP="$XDG_CACHE_HOME"/zsh/zcompdump-$ZSH_VERSION

    [[ -d "$XDG_STATE_HOME"/zsh ]] || mkdir -p "$XDG_STATE_HOME"/zsh
    [[ -d "$XDG_CACHE_HOME"/zsh ]] || mkdir -p "$XDG_CACHE_HOME"/zsh

    export HISTFILE="$XDG_STATE_HOME"/zsh/history
    zstyle ':completion:*' cache-path "$XDG_CACHE_HOME"/zsh/zcompcache
elif [ -n "$BASH_VERSION" ]; then
    [ -d "$XDG_STATE_HOME"/bash ] || mkdir -p "$XDG_STATE_HOME"/bash
    export HISTFILE="${XDG_STATE_HOME}"/bash/history
    export BASHDIR="$XDG_CONFIG_HOME"/bash
fi
