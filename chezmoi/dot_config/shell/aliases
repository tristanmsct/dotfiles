alias feishin="~/.config/hypr/launchers/feishin.sh"
alias slack="~/.config/hypr/launchers/slack.sh"
alias codium="~/.config/hypr/launchers/codium.sh"
alias vscodium="~/.config/hypr/launchers/codium.sh"
alias nextcloud="~/.config/hypr/launchers/nextcloud.sh"
alias steam="~/.config/hypr/launchers/steam.sh"

