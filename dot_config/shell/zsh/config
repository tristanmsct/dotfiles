# -----------------------------------------------------------------------------------------------------------------------------------------

# -----------------------------------------------------
# oh-myzsh plugins
# -----------------------------------------------------
plugins=(
    git
    sudo
    web-search
    archlinux
    copyfile
    copybuffer
    dirhistory
    uv
)

# -----------------------------------------------------
# Other plugins
# -----------------------------------------------------
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# -----------------------------------------------------
# Completion Scripts
# -----------------------------------------------------
# Initialize completion system
# /!\ Moving these instructions down can break the config /!\
fpath=("$XDG_CONFIG_HOME/shell/zsh/completions" $fpath)
autoload -Uz compinit && compinit -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"

# Set-up oh-my-zsh
source "$ZSH/oh-my-zsh.sh"

# -----------------------------------------------------
# Tools initialisations
# -----------------------------------------------------
# So that `task` get the same completion as `go-task`.
source <(task --completion zsh | sed 's/go_task/task/g; s/go-task/task/g')
source <(fzf --zsh)
eval "$(glow completion zsh)"
eval "$(eww shell-completions --shell zsh)"
eval "$(zoxide init zsh)"
eval "$(thefuck --alias)"
eval "$(uv generate-shell-completion zsh)"
eval "$(uvx --generate-shell-completion zsh)"

# -----------------------------------------------------
# Terminal Keybinds
# -----------------------------------------------------
bindkey "^?" backward-delete-char    # Backspace deletes a single character
bindkey "^W" backward-kill-word      # Ctrl + W (or remapped Ctrl + Backspace) deletes a word
