# Env elements come from .zshenv which is loaded before .zshrc. This file is for interactive shell configuration.
source "$ZDOTDIR/config"
source "$SHELLDIR/aliases"
source "$SHELLDIR/startup"
source "$SHELLDIR/lib/functions"

# Enable Powerlevel10k instant prompt. Should stay close to the top of .zshrc.
if [[ $(tty) == *"pts"* ]]; then
  if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  fi
  source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme

  [[ -f "$ZDOTDIR/prompt/p10k.zsh" ]] && source "$ZDOTDIR/prompt/p10k.zsh"
else
  [[ -f "$ZDOTDIR/prompt/zsh_tty_prompt.zsh" ]] && source "$ZDOTDIR/prompt/zsh_tty_prompt.zsh"
fi
