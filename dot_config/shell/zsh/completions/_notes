#compdef notes

local -a options
options=(
  ":Open today's notes"
  "--clean:Clean the day to day note directory"
  "-c:Clean the day to day note directory"
  "--month:Open notes for the current month"
  "-m:Open notes for the current month"
  "--archive:Archive old monthly notes"
  "-a:Archive old monthly notes"
  "--location:Open note location in a file explorer"
  "-l:Open note location in a file explorer"
  "--help:Display the help message for this function"
  "-h:Display the help message for this function"
)

_describe "values" options
