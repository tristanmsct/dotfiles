#compdef watcher-all

_watcher-all() {
    local -a options
    options=(
        ":Run main watchers"
        "--git:Performs a git check"
        "-g:Performs a git check"
        "--update:Check for updates"
        "-u:Check for updates"
        "--no-cache:Omits cache check"
        "-n:Omits cache check"
    )

    _describe "watcher-all options" options
}

_watcher-all "$@"
