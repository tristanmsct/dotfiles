#compdef watcher
# Only one file, otherwise side loading them can go wrong
# Main issue is when opening a new terminal if writting a whole command instead of using auto-complete then the
# auto-complete scripts might not be loaded at all.

_watcher-all() {
    local -a options
    options=(
        ":Run main watchers"
        "--git:Performs a git check"
        "-g:Performs a git check"
        "--help:Display help message"
        "-h:Display help message"
        "--no-cache:Omits cache check"
        "-n:Omits cache check"
        "--updates:Check for updates"
        "-u:Check for updates"
    )

    _describe "watcher all options" options
}

