_watcher() {
    local -a commands
    local watcher_dir="$HOME/.local/bin/watcher.d"

    case ${#words} in
        2)
            local cmd desc
            for script in "$watcher_dir"/*; do
                [[ -x "$script" ]] || continue
                cmd=$(basename "$script")
                [[ "$cmd" == _* ]] && continue

                desc=$(grep -m1 -oP '(?<=DESC = "|DESC=")[^"]+' "$script" 2>/dev/null)
                commands+=("$cmd:${desc:-No description}")
            done
            commands+=("open:Open the system notes directory")
            commands+=("--help:Display help message")
            commands+=("-h:Display help message")
            _describe "watcher command" commands
            ;;
        3)
            # Second argument: subcommands based on first arg.
            case ${words[2]} in
                all)            _watcher-all ;;
                ansible-check)  _watcher-ansible-check ;;
                cache)          _watcher-cache ;;
                chezmoi)        _watcher-chezmoi ;;
                desktop)        _watcher-desktop ;;
                git)            _watcher-git ;;
                pkglog)         _watcher-pkglog ;;
                sysinfo)        _watcher-sysinfo ;;
                updates)        _watcher-updates ;;
                xdg)            _watcher-xdg ;;
                open) ;; # no subcommands
            esac
            ;;
        4)
            case "${words[2]}/${words[3]}" in
                xdg/notes)      _watcher-xdg-notes ;;
                pkglog/notes)   _watcher-pkglog-notes ;;
                pkglog/diff)    _watcher-pkglog-diff ;;
                sysinfo/notes)  _watcher-sysinfo-notes ;;
                pkglog/query)   _watcher-pkglog-query ;;
                all/*)          _watcher-all ;;
            esac
            ;;
        5)
           case "${words[2]}/${words[3]}/${words[4]}" in
                pkglog/notes/query)             _watcher-pkglog-notes-query ;;
                xdg/notes/query-application)    _watcher-xdg-notes-query-application ;;
                xdg/notes/query)                _watcher-xdg-notes-query ;;
                sysinfo/notes/query)            _watcher-sysinfo-notes-query ;;
                pkglog/query/*)                 _watcher-pkglog-query ;;
                all/*/*)                        _watcher-all ;;
            esac
            ;;
        *)
            case "${words[2]}/${words[3]}" in
                pkglog/query)   _watcher-pkglog-query ;;
                all/*)          _watcher-all ;;
            esac
            ;;
    esac
}

_watcher "$@"
