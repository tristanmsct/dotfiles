#compdef watcher

_watcher() {
    local -a commands
    local watcher_dir="$HOME/.local/bin/watcher.d"

    case $CURRENT in
        2)
            # First argument: command names.
            for script in "$watcher_dir"/*; do
                [[ -x "$script" ]] || continue
                local cmd=$(basename "$script")
                [[ "$cmd" == _* ]] && continue
                local desc=""

                case "$cmd" in
                    all) desc="Run main watchers" ;;
                    cache) desc="Check for caches" ;;
                    chezmoi) desc="Track chezmoi-managed files" ;;
                    desktop) desc="Monitor .desktop file changes" ;;
                    git) desc="Check git repositories status" ;;
                    pkglog) desc="Monitor packages meta data" ;;
                    sysinfo) desc="Collect system information" ;;
                    updates) desc="Check for available updates" ;;
                    xdg) desc="Monitor xdg directories" ;;
                esac

                commands+=("$cmd:$desc")
            done
            commands+=("open:Open the system notes directory")
            commands+=("--help:Display help message")
            commands+=("-h:Display help message")
            _describe "watcher command" commands
            ;;
        3)
            # Second argument: subcommands based on first arg.
            case ${words[2]} in
                all)
                    _arguments "2:command:_watcher-all"
                    ;;
                cache)
                    _arguments "2:command:_watcher-cache"
                    ;;
                chezmoi)
                    _arguments "2:command:_watcher-chezmoi"
                    ;;
                desktop)
                    _arguments "2:command:_watcher-desktop"
                    ;;
                git)
                    _arguments "2:command:_watcher-git"
                    ;;
                pkglog)
                    _arguments "2:command:_watcher-pkglog"
                    ;;
                sysinfo)
                    _arguments "2:command:_watcher-sysinfo"
                    ;;
                updates)
                    _arguments "2:command:_watcher-updates"
                    ;;
                xdg)
                    _arguments "2:command:_watcher-xdg"
                    ;;
            esac
            ;;
        *)
            if [[ ${words[2]} == "xdg" ]] && [[ ${words[3]} == "notes" ]]; then
                 _arguments "3:command:_watcher-xdg-notes"
            elif [[ ${words[2]} == "pkglog" ]] && [[ ${words[3]} == "notes" ]]; then
                 _arguments "3:command:_watcher-pkglog-notes"
            elif [[ ${words[2]} == "pkglog" ]] && [[ ${words[3]} == "query" ]]; then
                _arguments "*:command:_watcher-pkglog-query"
            elif [[ ${words[2]} == "pkglog" ]] && [[ ${words[3]} == "diff" ]]; then
                _arguments "*:command:_watcher-pkglog-diff"
            elif [[ ${words[2]} == "sysinfo" ]] && [[ ${words[3]} == "notes" ]]; then
                 _arguments "3:command:_watcher-sysinfo-notes"
            elif [[ ${words[2]} == "all" ]]; then
                _arguments "*:command:_watcher-all"
            fi
            ;;
    esac
}

_watcher "$@"
