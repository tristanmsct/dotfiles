_watcher-sysinfo-notes() {
    local -a options
    options=(
      "add:Add a custom system file and its reason"
      "--help:Display help message"
      "-h:Display help message"
      "edit:Edit notes for a custom system file"
      "query:Query all or a specific custom sytem file"
      "remove:Remove notes for a custom system file"
      "search:Search for a custom system file or a reason by search term"
    )

    _describe "watcher sysinfo notes commands" options
}

_watcher-sysinfo() {
    local -a options
    options=(
        ":Collect system information"
        "--help:Display help message"
        "-h:Display help message"
        "--no-confirm:Does not ask before saving system info"
        "-n:Does not ask before saving system info"
        "notes:Manage notes for system custom file reasons"
    )

    _describe "watcher-sysinfo commands" options
}
