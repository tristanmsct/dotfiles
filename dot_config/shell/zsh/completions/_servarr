#compdef servarr
# shellcheck disable=SC2148,SC2034,SC2168

local -a options
options=(
  "up:Start containers"
  "down:Stop containers"
  "restart:Restart containers"
  "pull:Update container"
  "logs:Print logs for containers"
  "shutdown:Stops containers and docker"
  "--help:Display the help message for this function"
  "-h:Display the help message for this function"
)

_describe "values" options
