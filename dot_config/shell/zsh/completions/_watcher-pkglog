#compdef watcher-pkglog

_watcher-pkglog() {
    local -a options
    options=(
      "save:Save the current state, used as a pacman hook"
      "notes:Manage notes for packages reasons"
      "query:Query the package list (Repo -r, Name -n, Version -v, Installation type -t)"
      "diff:Display the difference between two states (default is last two, -c for choice)"
      "delete:Delete a package info file"
      "help:Display this help message"
    )

    _describe "watcher-pkglog commands" options
}

_watcher-pkglog "$@"
