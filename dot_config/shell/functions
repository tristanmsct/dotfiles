# Python docstring generation function.
docpy() {
    python -c '
    from datetime import datetime
    now_date = datetime.now().strftime("%Y-%m-%d")
    print(f"#!/usr/bin/env python \n\"\"\"\nCreated on {now_date}.\n\n@author: Tristan Muscat\n@email: tristan.muscat@pm.me\n\"\"\"\n")
    ' | wl-copy
}


