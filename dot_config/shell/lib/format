# Guard against double-sourcing
[[ -n "$_PRETTY_LOADED" ]] && return
_PRETTY_LOADED=1

# Disable colors when not in a terminal (e.g. cron, pipes)
if [[ -t 1 ]]; then
    ORANGE='\033[38;2;255;158;23m'
    BLUE='\033[38;2;73;136;252m'
    PURPLE='\033[38;2;150;85;166m'
    CYAN="\033[38;2;105;230;245m"
    GREEN='\033[38;2;125;235;103m'
    RED="\033[38;2;225;20;20m"
    BOLD='\033[1m'
    DIM='\033[2m'
    RESET='\033[0m'
else
    ORANGE='' BLUE='' PURPLE='' CYAN='' GREEN='' BOLD='' DIM='' RESET=''
fi

section()  { echo -e "${BOLD}${GREEN}=== $1 ===${RESET}"; }
subsection() { echo -e "\n${BOLD}${CYAN}▶ $1${RESET}"; }
subsubsection()  { echo -e "\n${BOLD}${PURPLE}- $1${RESET}"; }
