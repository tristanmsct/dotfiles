# Show colors in terminal.
show-colors() {
    for a in {40..47}; do
        echo -ne "\e[0;37;$a""m\\\e[0;37;$a""m\e[0;37;40m "
    done
}

fdxdg() {
    fd --exact-depth=1 $1 $XDG_CONFIG_HOME $XDG_CACHE_HOME $XDG_DATA_HOME $XDG_STATE_HOME
}

zf () {
    z $(zoxide query --score --list | fzf --filter "$*" 2>/dev/null | sort -nr -k1,1 | head -1 | awk '{ $1=""; sub(/^ /,""); print }')
}

batjq () {
    if [ $# -eq 0 ]; then
        echo "No argument passed"
    elif [ $# -eq 1 ]; then
        jq . "$1" | bat --language=json
    elif [ $# -eq 2 ]; then
        jq "$1" "$2" | bat --language=json
    else
        echo "Too many arguments"
    fi
}
