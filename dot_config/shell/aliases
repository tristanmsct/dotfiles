alias brave="brave.sh"
alias firefox="firefox.sh"
alias typora="typora.sh"
alias feishin="feishin.sh"
alias slack="slack.sh"
alias codium="codium.sh"
alias vscodium="codium.sh"
alias nextcloud="nextcloud.sh"
alias steam="steam.sh"

# These script are about starting the app with the right cursor.
alias vlc="vlc.sh"  # For VLC, it's because it is a Qt app and otherwise it does not have the right cursor.
