# ---------------------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------------------
alias ls="eza --icons=always"
alias lh="eza --icons=always --sort=type --oneline"
alias la="eza --icons=always --sort=type --oneline --all"
alias ll="eza --icons=always --sort=type --long"
alias l="eza --icons=always --sort=type --long --all"
alias lt="eza --tree --level=1 --icons=always --sort=type --all"
alias lg="eza --tree --level=1 --icons=always --sort=type --all --long --git-repos --git --no-filesize --no-time --no-user --no-permissions"

alias grep="grep --color=auto"
alias fgrep="fgrep --color=auto"
alias egrep="egrep --color=auto"

# Enable aliases to be sudo’ed.
alias sudo="sudo "

alias shutdown="systemctl poweroff"
alias wifi="nmtui"
alias wget="wget --hsts-file=$HOME/.local/share/wget-hsts"
alias ff="fastfetch"
alias bashterm="bash --rcfile $HOME/.config/shell/bash/bashrc"
alias open-dotfiles="xdg-open $HOME/.local/share/dotfiles > /dev/null 2>&1 & disown"
alias dufl="duf --only local"  # Show disk usage

# ---------------------------------------------------------------------------------------
# Kitty
# ---------------------------------------------------------------------------------------
alias icat="kitten icat"

# ---------------------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------------------
alias update-grub="sudo grub-mkconfig -o /boot/grub/grub.cfg"

# ---------------------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------------------
alias sba="source .venv/bin/activate"
alias poetry="nice poetry"

# ---------------------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------------------
alias dstart="sudo systemctl start docker containerd"
alias dc="docker compose"
alias dcu="docker compose up"
alias dcd="docker compose down"
alias dcr="docker compose restart"
alias dki="docker kill"
alias dps="docker container ls"
alias dcl="docker compose logs -f"
alias dpsf="docker ps --format 'table {{.Image}}\t{{.Names}}\t{{.Status}}'"
alias dstats="docker stats --no-stream"
alias dcstats="docker compose stats --no-stream"

# ---------------------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------------------
alias gad="git add ."
alias gci="git commit"
alias gcm="git commit -m"
alias gph="git push"
alias gpl="git pull"
alias gdi="git diff"
alias gst="git status"
alias glo="git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gma="git checkout main"
alias gco="git checkout"

if [ -n "$BASH_VERSION" ]; then
	source /usr/share/bash-completion/completions/git
	__git_complete gco _git_checkout
fi

# ---------------------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------------------
alias ke="kubectl get events --sort-by='.lastTimestamp'"
alias kppr="gcloud container clusters get-credentials ino-it-s-kroko-gke-cluster --region europe-west9 --project ino-it-s-kroko-ppr"

# ---------------------------------------------------------------------------------------
# Custom launchers
# ---------------------------------------------------------------------------------------
