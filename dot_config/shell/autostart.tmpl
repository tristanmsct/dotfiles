if [[ $(tty) == *"pts"* ]]; then
    # Get terminal dimensions.
    width=$(tput cols)
    height=$(tput lines)

    # Use a different template based on size.
    if (( width >= 110 && height >= 40 )); then
        fastfetch
    elif (( width >= 80 && height >= 20 )); then
        fastfetch -c "$HOME/.config/fastfetch/config_small.jsonc"
    fi
else
    echo "Start Hyprland with command Hyprland"
fi
