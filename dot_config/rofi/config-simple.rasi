 *
 * ----------------------------------------------------------------------------------------------------------------------------------------
 * For any type of search menu with a search bar and items bellow it.
 * Used by aliases, cliphist, keybindings, VPN and monitors menu.
 * ----------------------------------------------------------------------------------------------------------------------------------------
 */

@import "config-base.rasi"

// Configuration --------------------------------------------------------------------------------------------------------------------------
configuration {
    modi:                           "drun";
    show-icons:                     false;
	hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}

// Window / Mainbox -----------------------------------------------------------------------------------------------------------------------
window {
    width:                          30%;
    padding:                        1%;
}

mainbox {
    children:                       [ "listbox" ];
}

// Listbox --------------------------------------------------------------------------------------------------------------------------------
listbox {
    children:                       [ "inputbar", "listview" ];
}

// Search bar -----------------------------------------------------------------------------------------------------------------------------
inputbar {
	children: 						[ "textbox-prompt-colon", "entry" ];
}

entry {
    placeholder:                    "Search";
}

// Listview -------------------------------------------------------------------------------------------------------------------------------
listview {
    columns:                        1;
    lines:                          10;
    padding:                        1% 0 0 0;
}

// Elements -------------------------------------------------------------------------------------------------------------------------------
element {
    padding:                        1% 1% 1% 1.5%;
    margin:                         0.5% 0% 0% 0%;
}
