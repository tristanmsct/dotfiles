@import "config-base.rasi"

// Configuration --------------------------------------------------------------------------------------------------------------------------
configuration {
    modi:                           "drun";
    show-icons:                     false;
	hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}

// Window / Mainbox -----------------------------------------------------------------------------------------------------------------------
window {
    font:             "Fira Sans,Fira Sans Medium 16";
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            1000px;
    height:           380px;
    x-offset:         0px;
    y-offset:         0px;
    margin:           0px;
    padding:          0px;
    border-radius:    20px;
    cursor:           "default";
}

mainbox {
    enabled:          true;
    spacing:          15px;
    margin:           0px;
    background-color: transparent;
    orientation:      horizontal;
    children:         [ "imagebox", "listview" ];
}

// Imagebox --------------------------------------------------------------------------------------------------------------------------------
imagebox {
    border-radius:    20px 0px 0px 20px;
    background-color: transparent;
    background-image: url("~/.cache/wallpaper/square_wallpaper.png", height);
}

// Listview --------------------------------------------------------------------------------------------------------------------------------
listview {
    padding:          25px 20px 0px 0px;
    enabled:          true;
    cycle:            true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          10px;
    background-color: transparent;
    cursor:           "default";
}

// Elements --------------------------------------------------------------------------------------------------------------------------------
element {
    enabled:          true;
    padding:          10px;
    background-color: transparent;
    cursor:           pointer;
    padding:          1%;
}


element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}
