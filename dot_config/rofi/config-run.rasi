@import "config-base.rasi"

// Configuration --------------------------------------------------------------------------------------------------------------------------
configuration {
    modi:                           "run";
}

// Window / Mainbox --------------------------------------------------------------------------------------------------------------------------------
window {
    width:                          40%;
}

mainbox {
    children:                       [inputbar];
}

inputbar {
    children:                       [ "textbox-prompt-colon", "entry" ];
    padding:                        0.5%;
    border:                         false;
    background-color:               transparent;
}

textbox-prompt-colon {
    font:                           "Noto Sans Bold 14";
    str:                            ">";
}

entry {
    font:                           "Noto Sans 12";
    placeholder:                    "Command";
}
