@import "config-base.rasi"

// Configuration --------------------------------------------------------------------------------------------------------------------------
configuration {
    modi:                           "run";
    show-icons:                     false;
    font:                           "Fira Sans 14";
    sidebar-mode:                   false;
}

// Window / Mainbox --------------------------------------------------------------------------------------------------------------------------------
window {
    width:                          40%;
    padding:                        0.5%;
}

mainbox {
    children:                       [inputbar];
}

inputbar {
    children:                       [prompt, entry];
    padding:                        0.5%;
    border:                         false;
    background-color:               transparent;
}

entry {
    placeholder:                    "Command";
}
