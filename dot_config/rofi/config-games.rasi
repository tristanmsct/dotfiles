@import "config-base.rasi"

// Configuration --------------------------------------------------------------------------------------------------------------------------
configuration {
    show-icons:                     true;
}

* {
    font:                           "MesloLGS NF 14";
    background-color:               transparent;
    background:                   #1D2330;
    background-transparent:       #1D2330A0;
    text-color:                   #BBBBBB;
    text-color-selected:          #FFFFFF;
    primary:                        @main-color;
    important:                      @main-color;
}

// Window / Mainbox -----------------------------------------------------------------------------------------------------------------------
window {
    fullscreen:                     true;
    height:                         100%;
    width:                          100%;
    transparency:                   "real";
    background-color:               @background-transparent;
    border:                         0;
    border-radius:                  0;
    border-color:                   @primary;
}

mainbox {
    children:                       [prompt, inputbar-box, listview];
    padding:                        0;
}

// Search bar -----------------------------------------------------------------------------------------------------------------------------
inputbar {
    children:                       [textbox-prompt, entry];
    margin:                         0;
    padding:                        0;
    background-color:               @primary;
    border-color:                   @primary;
}

inputbar-box {
    children:                       [dummy, inputbar, dummy];
    orientation:                    horizontal;
    expand:                         false;
}

entry {
    expand:                         false;
    padding:                        1%;
    horizontal-align:               0;
    width:                          300;
    background-color:               @background;
    border-color:                   @primary;
    cursor:                         text;
}

prompt {
    width:                          100%;
    margin:                         0.3% 0% 0% 0.6%;
    text-color:                     @important;
    font:                           "MesloLGS NF 34";
}

textbox-prompt {
    text-color:                     @background;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    expand:                         false;
    str:                            "";
    font:                           "MesloLGS NF 24";
    padding:                        0% 0.5% 0% 0.5%;
}

// Listview -------------------------------------------------------------------------------------------------------------------------------
listview {
    layout:                         vertical;
    padding:                        4%;
    dynamic:                        true;
    columns:                        7;
    spacing:                        1%;
}

// Elements -------------------------------------------------------------------------------------------------------------------------------
element {
    children:                       [dummy, element-box, dummy];
    padding:                        0.5%;
    orientation:                    vertical;
    border:                         0px 4px solid 0px 4px;
    border-color:                   transparent;
}

element selected {
    border-color:                   @primary;
}

element-box {
    children:                       [element-icon, element-text];
    orientation:                    vertical;
    expand:                         false;
    cursor:                         pointer;
}

element-icon {
    cursor:                         inherit;
    size:                           33%;
    margin:                         0.5%;
}

element-text {
    padding:                        0% 0.5% 0.5% 0.5%;
    horizontal-align:               0.5;
    cursor:                         inherit;
    text-color:                     @text-color;
}

element-text selected {
    text-color:                     @text-color-selected;
}
