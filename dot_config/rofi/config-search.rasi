 *
 * ----------------------------------------------------------------------------------------------------------------------------------------
 * For any type of search menu with a search bar and items bellow it.
 * ----------------------------------------------------------------------------------------------------------------------------------------
 */

@import "config-base.rasi"

// Configuration --------------------------------------------------------------------------------------------------------------------------
configuration {
    modi:                           "drun";
    show-icons:                     false;
	hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}

// Window / Mainbox -----------------------------------------------------------------------------------------------------------------------
window {
    location:                       north;
    anchor:                         north;

    width:                          30%;
    x-offset:                       0;
    y-offset:                       10%;
    spacing:                        0;
    padding:                        1% 0.5% 0% 0.5%;
    margin:                         0;
}

mainbox {
    orientation:                    horizontal;
    spacing:                        0;
    margin:                         0;
    children:                       [ "listbox" ];
}

// Listbox --------------------------------------------------------------------------------------------------------------------------------
listbox {
    children:                       [ "inputbar", "message", "listview" ];
}

// Search bar -----------------------------------------------------------------------------------------------------------------------------
inputbar {
	children: 						[ "textbox-prompt-colon", "entry" ];
}

entry {
    placeholder:                    "Search";
}

// Listview -------------------------------------------------------------------------------------------------------------------------------
listview {
    columns:                        1;
    lines:                          10;
    padding:                        1%;
}

// Elements -------------------------------------------------------------------------------------------------------------------------------
element {
    padding:                        1% 0 1% 1%;
}

element-icon {
    background-color:               transparent;
    text-color:                     inherit;
    size:                           6%;
}

element-text {
    background-color:               transparent;
    text-color:                     inherit;
    vertical-align:                 0.5;
    horizontal-align:               0.0;
}
