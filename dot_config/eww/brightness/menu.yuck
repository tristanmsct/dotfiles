; -----------------------------------------------------------------------------------------------------------------------------------------

;; Variables
(defpoll hyprsunset-state
  :interval "1s"
  "jq -r '.hyprsunset.state' \"$XDG_STATE_HOME/desktop/state.json\""
)

(defpoll brightness-value
  :interval "200ms"
  "$(( $(brightnessctl g) * 100 / $(brightnessctl m) ))"
)

(defpoll keyboard-backlight-value
  :interval "200ms"
  "brightnessctl get -d '*kbd_backlight*'"
)

(defpoll sunset-value
  :interval "200ms"
  "jq -r '.hyprsunset.temperature // 0' \"$XDG_STATE_HOME/desktop/state.json\" | awk '{print int($1 / 50)}'"
)

(defpoll sunset-value-real
  :interval "200ms"
  "jq -r '.hyprsunset.temperature // 0' \"$XDG_STATE_HOME/desktop/state.json\""
)

;; Widget Definition
(defwidget brigntness-menu-control []
  (box
    :class "brightness-menu-widget"
    :orientation "v"
    :space-evenly false
    :spacing 15
    :halign "center"
    :valign "center"

    ;; Menu title
    (label
      :class "birghtness-menu-title"
      :xalign 0.1
      :text "Brightness menu"
    )

    ;; Group contained brightness elements
    (box
      :orientation "v"
      :class "element-group"

      ;; Monitor brightness slider
      (box
        :orientation "h"
        :space-evenly false
        :spacing 15

        (label
          :class "slider-label"
          :text "Monitor"
          :width 100
          :xalign 0.1
        )

        (box
          :class "slider-container"
          :halign "fill"
          :hexpand true
          (eventbox
            :cursor "pointer"
            (scale
              :class "brightness-slider"
              :min 0
              :max 21
              :timeout 1000
              :value brightness-slider-value
              :onchange "$DESKTOP_SCRIPTS/menus-eww/brightness/set-brightness.sh $(({} * 5))"
              :tooltip "Drag to change value (20-100)"
            )
          )
        )
      )

      ;; Keyboard brightness slider
      (box
        :orientation "h"
        :space-evenly false
        :spacing 15

        (label
          :class "slider-label"
          :text "Keyboard"
          :xalign 0.1
          :width 100
        )

        (box
          :class "slider-container"
          :halign "fill"
          :hexpand true
          (eventbox
            :cursor "pointer"
            (scale
              :class "brightness-slider"
              :min 0
              :max 4
              :timeout 1000
              :value keyboard-backlight-value
              :onchange "brightnessctl set {} -d '*kbd_backlight*' "
              :tooltip "Drag to change value (0-3)"
            )
          )
        )
      )
    )

    ;; Group contained hyprsunset elements
    (box
      :orientation "v"
      :class "element-group"
      :spacing 15


      ;; Blue light filter label
      (box
        :orientation "h"

        (label
          :text "Blue Light Filter"
          :class "blue-light-filter-label"
          :xalign 0.1
        )

        (box
          :class "separator"
          :orientation "h"
        )

      )

      ;; Hyprsunset elements
      (box
        :orientation "h"
        :space-evenly true
        :spacing 25

        ;; Hyprsunset toggle button
        (eventbox
          :cursor "pointer"
          (button
            :class {hyprsunset-state == "on" ? "control-button-active" : "control-button"}
            :onclick "$DESKTOP_SCRIPTS/menus-eww/brightness/menu-hyprsunset-button.sh on"
            :tooltip "Click to enable hyprsunset"
            "On"
          )
        )

        (eventbox
          :cursor "pointer"
          (button
            :class {hyprsunset-state == "auto" ? "control-button-active" : "control-button"}
            :onclick "$DESKTOP_SCRIPTS/menus-eww/brightness/menu-hyprsunset-button.sh auto"
            :onrightclick "$DESKTOP_SCRIPTS/menus-eww/brightness/menu-hyprsunset-slider.sh 6500"
            :tooltip "Click to toogle hyprsunset auto timer (right click to reset temp)"
            "Auto"
          )
        )

        (eventbox
          :cursor "pointer"
          (button
            :class {hyprsunset-state == "off" ? "control-button-active" : "control-button"}
            :onclick "$DESKTOP_SCRIPTS/menus-eww/brightness/menu-hyprsunset-button.sh off"
            :tooltip "Click to disable hyprsunset"
            "Off"
          )
        )
      )

      (box
        :orientation "h"
        :space-evenly false
        :spacing 15

        (label
          :class "slider-label"
          :text "Temp"
        )

        (box
          :class "slider-container"
          :halign "fill"
          :hexpand true
          (eventbox
            :cursor "pointer"
            (scale
              :class  {
                        sunset-value < 130 ? "hyprsunset-slider hot" :
                        sunset-value > 130 ? "hyprsunset-slider cold" :
                        "hyprsunset-slider"
                      }
              :min 20
              :max 401
              :timeout 1000
              :value sunset-value
              :onchange "$DESKTOP_SCRIPTS/menus-eww/brightness/menu-hyprsunset-slider.sh $(({} * 50))"
              :tooltip "Drag to change value (1000 - 20000)"
            )
          )
        )

        (label
          :class "slider-label"
          :text "${sunset-value-real}K"
        )
      )
    )
  )
)

;; Brightness window closer
; This is a overlay invisible window over the entire screen that catches clicks and closes both windows when clicked.
(defwindow brightness-menu-window-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "brightness-menu-window")
)

;; Window Definition
(defwindow brightness-menu-window
  :monitor 0
  :orientation "v"
  :geometry (geometry
    :anchor "center"
    :x "2%"
  )
  :stacking "fg"
  :wm-ignore false
  :resizable false
  (box
    :orientation "v"
    :spacing 0
    (brigntness-menu-control)
  )
)
