(defpoll wallust-colors
  :interval "2s"
  :initial "$HOME/.config/eww/themes/scripts/spit-hot-colors.sh"
  "$HOME/.config/eww/themes/scripts/spit-hot-colors.sh"
)

(defpoll borders-on
  :interval "2s"
  :initial "if (hyprctl getoption general:col:active_border | grep -q 'gradient data: 0 0 0deg'); then echo 'false'; else echo 'true'; fi"
  "if (hyprctl getoption general:col:active_border | grep -q 'gradient data: 0 0 0deg'); then echo 'false'; else echo 'true'; fi"
)

; Since waybar borders are disabled in focus mode, it is not reliable to know if borders are on or not
; this is why I'm using eww borders as an indicator here.
; (defpoll borders-decorations-on
;   :interval "2s"
;   :initial "if (grep -q 'border: 2px solid rgba' $HOME/.config/waybar/style.css); then echo 'false'; else echo 'true'; fi"
;   "if (grep -q 'border: 2px solid rgba' $HOME/.config/waybar/style.css); then echo 'false'; else echo 'true'; fi"
; )

(defpoll borders-decorations-on
  :interval "2s"
  :initial "if (grep -q '$border-color: transparent' $HOME/.config/eww/colors-eww.scss); then echo 'false'; else echo 'true'; fi"
  "if (grep -q '$border-color: transparent' $HOME/.config/eww/colors-eww.scss); then echo 'false'; else echo 'true'; fi"
)

(defvar saturation-value 0.5)

;; Widget Definition
(defwidget theme-menu-control []
  (box
    :class "theme-menu-widget"
    :orientation "v"
    :width 450
    :space-evenly false
    :spacing 15
    :halign "center"
    :valign "center"

    ;; Menu title
    (label
      :class "theme-menu-title"
      :xalign 0.1
      :text "Theme menu"
    )

    ;; List of accent colors from wallust
    (box
      :class "color-chooser"
      :orientation "v"

      (for entry in wallust-colors
        (eventbox
          :cursor "pointer"
          (button
            :class "color-item"
            ; The nohup command is to detach the execution of the script since there is a sleep in the function
            ; otherwise the execution is killed when the sleep occurs.
            :onclick "nohup $HOME/.config/eww/themes/scripts/set-hot-colors.sh '${entry}' &"
            :tooltip "Click to select a color theme"
            (label :markup "${entry}")
          )
        )
      )
    )

    ;; Border menu
    (box
      :orientation "h"
      :space-evenly true
      :spacing 15

      ;; Global borders
      (eventbox
        :cursor "pointer"
        (button
          :class {borders-on == "true" ? "control-button-active" : "control-button"}
          :onclick "$HOME/.config/eww/themes/scripts/switch-borders.sh ${borders-on}"
          :tooltip "Enable / disable borders on main windows"
          "Main borders"
        )
      )

      ;; Decoration borders
      (eventbox
        :cursor "pointer"
        (button
          :class {borders-decorations-on == "true" ? "control-button-active" : "control-button"}
          :onclick "$HOME/.config/eww/themes/scripts/switch-borders-decorations.sh ${borders-decorations-on}"
          :tooltip "Enable / disable borders on decorations"
          "Decorations borders"
        )
      )

    )

    ;; Saturation menu
    (box
      :orientation "h"
      :space-evenly false
      :spacing 15

      ;; Saturation toggle button
      (eventbox
        :cursor "pointer"
        (button
          :class "control-button"
          :onclick "$HOME/.config/eww/themes/scripts/saturate.sh ${saturation-value}"
          :tooltip "Click to apply chosen saturation"
          "Saturate"
        )
      )

      ;; saturation slider
      (box
        :class "slider-container"
        :halign "fill"
        :hexpand true
        (eventbox
          :cursor "pointer"
          (scale
            :class  "brightness-slider"
            :min 0.01
            :max 2
            :round-digits 2
            :timeout 1000
            :value saturation-value
            :onchange "eww update saturation-value={}"
            :tooltip "Drag to change value (0 - 1)"
          )
        )
      )
    )

    ;; Dark and light theme switcher
    (eventbox
      :cursor "pointer"
      (button
        :class "control-button-active"
        :onclick "$HOME/.config/eww/themes/scripts/switch-theme.sh"
        :tooltip "Click to switch between dark and light theme"
        (label :markup "Dark / Light Theme")
      )
    )

  )
)

;; Theme window closer
; This is a overlay invisible window over the entire screen that catches clicks and closes both windows when clicked.
(defwindow theme-menu-window-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "theme-menu-window")
)

;; Window Definition
(defwindow theme-menu-window
  :monitor 0
  :orientation "v"
  :geometry (geometry
    :x "0"
    :y "0"
    :width "400px"
    :height "150px"
    :anchor "center"
  )
  :stacking "overlay"
  :wm-ignore false
  :resizable false
  (box
    :orientation "v"
    :spacing 0
    (theme-menu-control)
  )
)
