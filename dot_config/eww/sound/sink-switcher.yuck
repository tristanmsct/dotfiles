(defpoll sink-list
  :interval "2s"
  :initial "$HOME/.config/eww/sound/scripts/get-sink-list.sh"
  "$HOME/.config/eww/sound/scripts/get-sink-list.sh"
)


(defwidget sink-switcher []
  (box
    :class "sink-switch-widget"
    :orientation "v"
    :width 350
    :height 50
    :space-evenly false
    :spacing 3
    :halign "center"
    :valign "center"

    (for entry in sink-list
      (eventbox
        :cursor "pointer"
        (button
          :class "switch-item"
          :onclick '$HOME/.config/eww/sound/scripts/switch-sink.sh "${entry}"'
          (label :markup "${entry}")
        )
      )
    )
  )
)

;; Sink switcher window closer
; This is a overlay invisible window over the entire screen that catches clicks and closes both windows when clicked.
(defwindow sink-switcher-window-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "sink-switcher-window")
)

(defwindow sink-switcher-window
  :monitor 0
  :geometry (geometry
    :x "6%"
    :y "6%"
    :anchor "top right"
  )
  :stacking "fg"
  :wm-ignore false
  :resizable false
  (box
    (sink-switcher)
  )
)
