; -----------------------------------------------------------------------------------------------------------------------------------------

(defpoll sound-icon
  :interval "100ms"
  :initial "$DESKTOP_SCRIPTS/menus-eww/sound/get-icon.sh"
  "$DESKTOP_SCRIPTS/menus-eww/sound/get-icon.sh"
)

(defpoll sound-slider-value
  :interval "200ms"
  :initial "echo $(( $(amixer sget Master | awk -F'\\[\\]\\[\\]' '/Left:/ { print $2 }' | tr -d '%') / 5 ))"
  "echo $(( $(amixer sget Master | awk -F'\\[\\]\\[\\]' '/Left:/ { print $2 }' | tr -d '%') / 5 ))"
)

(defwindow sound-slider-window-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "sound-slider-window")
)

(defwindow sound-slider-window-secondary-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "sound-slider-window-secondary")
)

;; Widget Definition
(defwidget sound-slider-control []
  (box
    :class "sound-slider-widget"
    :orientation "h"
    :space-evenly false
    :spacing 15
    :halign "center"
    :valign "center"

    ;; Button
    (eventbox
      :cursor "pointer"
      (button
        :class "mute-button"
        :onclick "$DESKTOP_SCRIPTS/menus-eww/sound/set-sound.sh mute"
        :onrightclick "$DESKTOP_SCRIPTS/menus-eww/sound/open-sink-switcher.sh"

        :tooltip
"Left click to mute / unmute
Right click to switch main audio output"
        sound-icon
      )
    )

    ;; Slider
    (box
      :halign "fill"
      :hexpand true
      (eventbox
        :cursor "pointer"
        (scale
          :class "sound-slider"
          :min 0
          :max 21
          :timeout 1000
          :value sound-slider-value
          :onchange "$DESKTOP_SCRIPTS/menus-eww/sound/set-sound.sh $(( {} * 5 ))"

          :tooltip "Drag to change value (0-100)"
        )
      )
    )
  )
)

;; Window Definition
(defwindow sound-slider-window
  :monitor 0
  :geometry (geometry
    :x "8%"
    :anchor "top right"
  )
  :stacking "fg"
  :wm-ignore false
  :resizable false
  (box
    (sound-slider-control)
  )
)

; I lost my sanity tring to put `:x` in a variable, that just seems impossible.
(defwindow sound-slider-window-secondary
  :monitor 0
  :geometry (geometry
    :x "6%"
    :anchor "top right"
  )
  :stacking "fg"
  :wm-ignore false
  :resizable false
  (box
    (sound-slider-control)
  )
)
