{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "top": 7,
      "left": 1,
      "right": 6
    }
  },
  "display": {
    "separator": "",
    "size": {
      "ndigits": 0,
      "binaryPrefix": "si"
    },
    "percent": {
      "type": 2
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": " "
      }
    },
    "key": {
      "width": 6
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "31",
        "host": "32"
      }
    },
    {
      "type": "separator",
      "string": "▔"
    },
    {
        "type": "custom",
        "format": "System"
    },
    {
      "type": "os",
      "key": "├─",
      "format": "{pretty-name}",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "key": "├─󰒔",
      "format": "{sysname} {release}",
      "keyColor": "31"
    },
    {
      "type": "InitSystem",
      "key": "├─",
      "keyColor": "31"
    },
    {
      "type": "shell",
      "key": "├─$",
      "keyColor": "31"
    },
    {
      "type": "command",
      "key": "├─",
      "keyColor": "31",
      "text": "TOTAL=$(pacman -Q | wc -l); EXPLICIT=$(pacman -Qe | wc -l); AUR=$(pacman -Qm | wc -l); DEPS=$((TOTAL-EXPLICIT-AUR)); echo \"$TOTAL (explicit: $EXPLICIT, AUR: $AUR, deps: $DEPS)\""
    },
    {
        "type": "localip",
        "key": "├─󰩟",
        "format": "{ipv4} ({ifname})",
        "keyColor": "31"
    },
    {
      "type": "locale",
      "key": "├─󰇧",
      "keyColor": "31"
    },
    {
      "type": "uptime",
      "key": "╰─󰔚",
      "keyColor": "31"
    },
    "break",
    {
        "type": "custom",
        "format": "Hardware"
    },
    {
      "type": "host",
      "key": "├─󰟀",
      "format": "{family}",
      "keyColor": "32"
    },
    {
      "type": "cpu",
      "key": "├─󰻠",
      "keyColor": "32",
      "freqNdigits": 1
    },
    {
      "type": "gpu",
      "key": "├─󰢮",
      "format": "{vendor} {name} ({driver})",
      "keyColor": "32"
    },
    {
      "type": "memory",
      "key": "├─",
      "keyColor": "32"
    },
    {
      "type": "swap",
      "key": "├─󰿡",
      "keyColor": "32"
    },
    {
      "type": "disk",
      "key": "├─󰋊",
      "keyColor": "32"
    },
    {
      "type": "sound",
      "key": "├─󰓃",
      "format": "{platform-api} - {name}",
      "keyColor": "32"
    },
    {
      "type": "display",
      "key": "├─󰹑",
      "keyColor": "32"
    },
    {
      "type": "battery",
      "key": "╰─󱊣",
      "keyColor": "32"
    },
    "break",
    {
        "type": "custom",
        "format": "Environment"
    },
    {
      "type": "wm",
      "key": "├─",
      "keyColor": "33"
    },
    {
        "type": "lm",
        "key": "├─󰧨",
        "keyColor": "33"
    },
    {
      "type": "theme",
      "key": "├─󰉼",
      "keyColor": "33"
    },
    {
      "type": "icons",
      "key": "├─",
      "keyColor": "33"
    },
    {
      "type": "cursor",
      "key": "├─󰳽",
      "keyColor": "33"
    },
    {
      "type": "font",
      "key": "├─",
      "format": "{font1}",
      "keyColor": "33"
    },
    {
      "type": "terminal",
      "key": "╰─",
      "keyColor": "33"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}