#!/usr/bin/env python3

def is_vanilla() -> bool:
    """Return whether running "vanilla" Python"""
    import os
    return os.environ.get("UV") is None


def setup_history():
    import os
    import atexit
    import readline
    from pathlib import Path

    if state_home := os.environ.get("XDG_STATE_HOME"):
        state_home = Path(state_home)
    else:
        state_home = Path.home() / ".local" / "state"

    # libedit and GNU readline use incompatible history file formats
    backend = getattr(readline, "backend", None) or (
        "editline" if "libedit" in (readline.__doc__ or "") else "readline"
    )

    history: Path = state_home / "python" / f"history_{backend}"
    history.parent.mkdir(parents=True, exist_ok=True)

    readline.clear_history()
    if history.exists():
        try:
            readline.read_history_file(str(history))
        except OSError:
            # corrupt or wrong-format file, start fresh
            pass

    import site
    site.write_history = lambda *args, **kwargs: None  # no-op
    atexit.register(readline.write_history_file, str(history))


setup_history()
