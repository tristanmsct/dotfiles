// Rasi colors -- Generated by Wallust
* {
    color-0:     {{color0}};
    color-1:     {{color1}};
    color-2:     {{color2}};
    color-3:     {{color3}};
    color-4:     {{color4}};
    color-5:     {{color5}};
    color-6:     {{color6}};
    color-7:     {{color7}};
    color-8:     {{color8}};
    color-9:     {{color9}};
    color-10:    {{color10}};
    color-11:    {{color11}};
    color-12:    {{color12}};
    color-13:    {{color13}};
    color-14:    {{color14}};
    color-15:    {{color15}};

    color-tr-1: rgba({{color1 | rgb}},0.3);
    color-tr-2: rgba({{color2 | rgb}},0.3);
    color-tr-3: rgba({{color3 | rgb}},0.3);
    color-tr-4: rgba({{color4 | rgb}},0.3);
    color-tr-5: rgba({{color5 | rgb}},0.3);
    color-tr-6: rgba({{color6 | rgb}},0.3);
    color-tr-7: rgba({{color7 | rgb}},0.3);
    color-tr-8: rgba({{color8 | rgb}},0.3);

    accent-color: @color-1;
    accent-color-transparent: @color-tr-1;
    foreground: #eeeeee;
    background: rgba(0, 0, 0, 0.4);
    border-accent-color: @accent-color;
}
