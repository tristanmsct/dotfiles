//  __  __           _       _
// |  \/  | ___   __| |_   _| | ___  ___
// | |\/| |/ _ \ / _` | | | | |/ _ \/ __|
// | |  | | (_) | (_| | |_| | |  __/\__ \
// |_|  |_|\___/ \__,_|\__,_|_|\___||___/
//

{
    // Left Modules -----------------------------------------------------------------------------------------------------------------------

    // Application Launcher -------------------------------------------------------------
    "custom/appmenu": {
        "format": "<span size='x-large'>󰣇</span>",
        "on-click": "pkill rofi || rofi -show drun -replace -i -disable-history",
        "on-click-middle": "~/.config/nwg-panel/menu-start.sh",
        "on-click-right": "DESKTOP_SCRIPTS/menus-rofi/keybindings.sh",
        "tooltip-format": "<span line_height='1.5'>Left: Open Rofi application launcher</span>\n<span line_height='1.5'>Middle: Open the NWG application launcher   </span>\n<span line_height='1.5'>Right: Show all keybindings</span>"
        // "tooltip": false
    },

    // Group Quicklinks -----------------------------------------------------------------
    "group/quicklinks": {
        "orientation": "horizontal",
        "modules": [
            "custom/filemanager",
            "custom/browser",
            "custom/terminal",
            "custom/editor",
            "custom/typora"
         ]
    },


    "custom/filemanager": {
        "format": "<span size='x-large'></span>",
        "on-click": "nautilus",
        "tooltip-format": "Open File Manager - Nautilus"
        // "tooltip": false
    },

    "custom/browser": {
        "format": "<span size='x-large'></span>",
        "on-click": "brave",
        "tooltip-format": "Open Web Browser - Brave"
        // "tooltip": false
    },

     "custom/terminal": {
        "format": "<span size='x-large'></span>",
        "on-click": "kitty",
        "tooltip-format": "Open Terminal - Kitty"
        // "tooltip": false
    },

    "custom/editor": {
        "format": "<span size='x-large'></span>",
        "on-click": "subl",
        "tooltip-format": "Open Text Editor - Sublime"
        // "tooltip": false
    },

    "custom/typora": {
        "format": " <span size='x-large'>󰊄</span> ",
        "on-click": "typora",
        "tooltip-format": "Open Note Application - Typora"
        // "tooltip": false
    },

    // Workspaces -----------------------------------------------------------------------
    // Workspaces are handled directly in the config file because the workspace widget is not the same
    // on each screen.

    // Taskbar --------------------------------------------------------------------------
    "wlr/taskbar": {
        "format": "{icon}",
        "all-outputs": true,
        "icon-size": 24,
        "spacing": 0,
        "tooltip-format": "{name} - {title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "fullscreen",
        // "ignore-list": ["kitty"],
        // To add steam game icons to waybar, their ID need to be mapped to their name.
        // If the icon does not exists, usually `right click` > "Manage" > "Add desktop shortcut" in Steam will
        // create an icon in ~/.local/share/icons/hicolor and a .desktop file in ~/Documents/Desktop
        // Check Arch guide in the icon section for more info.
        // General rule : add the client class (id) as a key, and a correponding .desktop file as a value.
        "app_ids-mapping": {
          "firefoxdeveloperedition": "firefox-developer-edition",
          "steam_app_1996010": "Crow Country",
          "steam_app_294100": "RimWorld by Ludeon Studios",
          "steam_app_2239150": "Thronefall",
          "steam_app_219740": "Don't Starve",
          "FTL.amd64": "FTL: Faster Than Light",
          "org.nmrs.ui": "network-wireless",
          "nmtui": "network-wireless",
          "networkpwd": "network-wireless",
          "brave-__home_tristan_.local_share_scripts_system_system-paths.html-Default": "cheatsheet"
        },
        "rewrite": {
          "Firefox Web Browser": "Firefox"
        }
    },

    // Center Modules ---------------------------------------------------------------------------------------------------------------------

    // Center group ---------------------------------------------------------------------
    "group/center": {
        "orientation": "horizontal",
        "modules": [
            // "custom/debugger",
            "clock",
            "custom/vpnstatus"
            // "custom/updates"
        ]
    },

    "group/center-secondary": {
        "orientation": "horizontal",
        "modules": [
            "clock"
        ]
    },

    // Debugger
    "custom/debugger": {
        "format": " <span size='medium'></span> ",
        "exec": "$DESKTOP_SCRIPTS/system/debug-state.sh",
        // "on-click": "subl ~/.local/state/desktop/state.json",
        "restart-interval": 60,
        "escape": true,
        "interval": 2,
        "return-type": "json",
        "tooltip": true,
        "tooltip-format": "Check if state file is ok",
        "markup": true
    },

    // Clock
    "clock": {
        "format": "{:%H:%M - %a %d %b}",
        "on-click": "gnome-calendar",
        "tooltip": false
    },

    // VPN
    "custom/vpnstatus": {
        "format": "<span size='medium'>{}</span>",
        "exec": "$DESKTOP_SCRIPTS/vpn/get-status.sh",
        "on-click": "$DESKTOP_SCRIPTS/menus-rofi/vpn.sh",
        "interval": 5,
        "return-type": "json"
    },

    // Updater
    "custom/updates": {
        // "format": "<span size='medium'>{}</span>",
        "exec": "$DEKSTOP_SCRIPTS/system/updates.sh",
        "on-click": "$DEKSTOP_SCRIPTS/system/updates.sh up",
        "restart-interval": 60,
        "escape": true,
        "interval": 60,
        "return-type": "json",
        "tooltip": true,
        "markup": true
    },

    // Right Modules ----------------------------------------------------------------------------------------------------------------------

    // Group Misc -----------------------------------------------------------------------
    "group/misc": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-misc",
            "transition-right-to-left": false
        },
        "modules": [
            "custom/misc",
            "custom/theme_switch",
            "idle_inhibitor",
            "custom/cliphist",
            "custom/hyprsunset",
            "custom/gamemode",
            "custom/printer",
            "custom/docker",
            "custom/cava_input"
        ]
    },

    // Simple arrow for the drawer
    "custom/misc": {
        "format": "",
        "tooltip": false
    },

    // Light Dark themes swith
    "custom/theme_switch": {
        "format": " <span size='large'>󰔎</span> ",
        "on-click": "$DESKTOP_SCRIPTS/theming/switch-theme.sh",
        "on-click-right": "$DESKTOP_SCRIPTS/menus-eww/themes/display-theme-menu.sh",
        "tooltip-format":
            "Switch between light and dark theme"
    },

    // Idle Inhibitor
    "idle_inhibitor": {
        "format": "<span size='large'>{icon}</span>",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Deactivate Caffeine",
        "tooltip-format-deactivated": "Activate Caffeine"
    },

    // Cliphist
    "custom/cliphist": {
        "format": " <span size='large'>󰅍</span> ",
        "on-click": "$DESKTOP_SCRIPTS/menus-rofi/cliphist.sh",
        "on-click-right": "$DESKTOP_SCRIPTS/menus-rofi/cliphist.sh delete",
        "on-click-middle": "$DESKTOP_SCRIPTS/menus-rofi/cliphist.sh wipe",
        "tooltip-format":
            "Clipboard Manager\nLeft click: open cliphist\nRight click: delete entry from cliphist\nMiddle click: wipe cliphist"
    },

    // Hyprsunset
    "custom/hyprsunset": {
        "format": " <span size='large'>󱄤</span> ",
        "tooltip-format": "Toggle Hyprsunset",
        "on-click": "$DESKTOP_SCRIPTS/hyprland/hyprsunset/hyprsunset.sh",
        "on-click-middle": "$DESKTOP_SCRIPTS/hyprland/hyprsunset/hyprsunset.sh autotimer-switch",
        "on-click-right": "$DESKTOP_SCRIPTS/menus-eww/brightness/display-brightness-menu.sh",
        "exec": "$DESKTOP_SCRIPTS/hyprland/hyprsunset/hyprsunset-status.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8
    },

    // Game mode
    "custom/gamemode": {
        "format": " <span size='x-large'>󰊗</span> ",
        "tooltip-format": "Toggle Game Mode",
        "on-click": "$DESKTOP_SCRIPTS/focus-mode/activate.sh"
    },

    // Printer
    "custom/printer": {
        "format": " <span size='x-large'>󰐪</span> ",
        "tooltip-format": "Toggle cups service",
        "on-click": "$DESKTOP_SCRIPTS/system/cups-toggle.sh",
        "exec": "$DESKTOP_SCRIPTS/system/cups-toggle.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 9
    },

    // Docker
    "custom/docker": {
        "format": " <span size='x-large'></span> ",
        "tooltip-format": "Toggle docker service",
        "on-click": "$DESKTOP_SCRIPTS/system/docker-toggle.sh",
        "exec": "$DESKTOP_SCRIPTS/system/docker-toggle.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 10
    },

    // Cava input switcher
    "custom/cava_input": {
        "format": " <span size='small'>󱡫</span> ",
        "tooltip-format": "Switcher cava input source",
        "on-click": "$DESKTOP_SCRIPTS/cava/cava-input-switcher.sh"
    },

    // Cava -----------------------------------------------------------------------------

    "cava": {
        "framerate": 30,
        "autosens": 1,
        "hide_on_silence": true,
        "sleep_timer": 2,
        "bars": 12,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": true,
        "waves": true,
        "noise_reduction": 0.4,
        "input_delay": 2,
        "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
           "on-click-right": "mode"
        }
    },

    // Group Devices --------------------------------------------------------------------
    "group/devices": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "bluetooth",
            "network",
            "backlight",
            "battery"
        ]
    },

    "group/devices-secondary": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "bluetooth",
            "network"
        ]
    },

    // Pulseaudio
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": " {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󱡒",
            "headset": "󰋎",
            "phone": "",
            "portable": "󰄜",
            "car": "",
            "default": ""
        },
        "on-click": "$DESKTOP_SCRIPTS/menus-eww/sound/display-sound-slider.sh",
        "on-click-middle": "pavucontrol",
        "on-click-right": "$DESKTOP_SCRIPTS/media/audio-helper.sh"
    },

    "bluetooth": {
        "format": " ø",
        "format-disabled": "", // an empty format will hide the module
        "format-connected": " {num_connections}",
        "on-click": "adw-bluetooth",
        "tooltip-format": "  {device_alias} ",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "  {device_alias}",
        "tooltip-format-enumerate-connected-battery": "  {device_alias}\t{device_battery_percentage}%"
    },

    "backlight": {
        "format": " <span size='large'>{icon}</span> {percent}% ",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false,
        "min-brightness": 20,
        "scroll-step": 5,
        "on-click": "$DESKTOP_SCRIPTS/menus-eww/brightness/display-brightness-slider.sh",
        "on-click-middle": "brightnessctl set $(($(brightnessctl max) * 80 / 100))",
        "on-click-right": "$DESKTOP_SCRIPTS/menus-eww/brightness/display-brightness-menu.sh"
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "<span size='large'>󰤨</span> {signalStrength}%",
        "format-ethernet": "<span size='large'>󱘖</span> Wired",
        "format-linked": "<span size='large'>󰒃</span> VPN",
        "format-disconnected": " Off",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "   {essid} |    {bandwidthUpBytes} |    {bandwidthDownBytes}",
        "tooltip-format-ethernet": "󱘖   {ifname} |    {bandwidthUpBytes} |    {bandwidthDownBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5,
        "max-length": 50,
        "on-click": "nmrs",
        "on-click-right": "networkmanager"
    },

    // Battery
    "battery": {
        "states": {
            "warning": 20,
            "low": 10,
            "critical": 5
        },
        "format": " <span size='small'>{icon}</span> {capacity}% ",
        "format-charging": " <span size='large'>󰂅</span> {capacity}%",
        "format-plugged": " <span size='large'>󰂅</span> {capacity}%",
        // "format-alt": "{icon}  {time}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-update": "$DESKTOP_SCRIPTS/system/battery-monitor.sh"
    },

    // Group System ---------------------------------------------------------------------
    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "custom/power"
        ]
    },

    "custom/power": {
        "format": "<span size='large'></span>",
        "on-click": "wlogout -b 2",
        "tooltip-format": "<span>    Power Menu</span>"
    }
}
