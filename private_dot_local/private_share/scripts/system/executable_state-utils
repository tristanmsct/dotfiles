# The default "$HOME/.local/state" is needed for the systemd timer.
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/state.json"

state_get() {
    local element="${1:?usage: state_get ELEMENT [FILE]}"
    local file="${2:-$STATE_FILE}"

    jq -r "$element" "$file"
}

state_set() {
    local element="${1:?usage: state_set ELEMENT VALUE [FILE]}"
    local value="${2:?usage: state_set ELEMENT VALUE [FILE]}"
    local file="${3:-$STATE_FILE}"
    local lock="${file}.lock"

    (
        exec 200>"$lock" || exit 1
        flock -x 200
        tmp=$(mktemp)

        if printf '%s' "$value" | jq . >/dev/null 2>&1; then
            jq --argjson val "$value" "$element = \$val" "$file" > "$tmp" && mv "$tmp" "$file"
        else
            jq --arg val "$value" "$element = \$val" "$file" > "$tmp" && mv "$tmp" "$file"
        fi

        rm -f "$lock"
    )
}

state_del() {
    local element="${1:?usage: state_del ELEMENT [FILE]}"
    local file="${2:-$STATE_FILE}"
    local lock="${file}.lock"

    (
        exec 200>"$lock" || exit 1
        flock -x 200
        tmp=$(mktemp)
        jq "del($element)" "$file" > "$tmp" && mv "$tmp" "$file"
        rm -f "$lock"
    )
}
