# Needed for the systemd timer.
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/state.json"
STATE_LOCK="$STATE_FILE.lock"

mkdir -p "$(dirname "$STATE_FILE")"

state_get() {
    jq -r "$1" "$STATE_FILE"
}

state_set() {
    (
        exec 200>"$STATE_LOCK" || exit 1
        flock -x 200
        tmp=$(mktemp)
        # Determine if $2 is valid JSON. If so, use --argjson, else use --arg for string.
        if printf '%s' "$2" | jq -e . >/dev/null 2>&1; then
            jq --argjson val "$2" "$1 = \$val" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
        else
            jq --arg val "$2" "$1 = \$val" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
        fi
        rm -f "$STATE_LOCK"
    )
}

state_del() {
    (
        exec 200>"$STATE_LOCK" || exit 1
        flock -x 200
        tmp=$(mktemp)
        jq "del($1)" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
        rm -f "$STATE_LOCK"
    )
}
