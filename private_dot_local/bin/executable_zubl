#!/usr/bin/env bash
#            _     _
#  _____   _| |__ | |
# |_  / | | | '_ \| |
#  / /| |_| | |_) | |
# /___|\__,_|_.__/|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

if [ $# -eq 0 ]; then
    target="$HOME"
else
    target=$(zoxide query --list | fzf --filter "$*" | head -1 2>/dev/null)
    if [ -z "$target" ]; then
        target="$HOME"
    fi
fi
subl $target > /dev/null 2>&1 & disown
