#!/usr/bin/env bash
#                _       _                        _           _    _
# __      ____ _| |_ ___| |__   ___ _ __       __| | ___  ___| | _| |_ ___  _ __
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|____ / _` |/ _ \/ __| |/ / __/ _ \| '_ \
#  \ V  V / (_| | || (__| | | |  __/ | |_____| (_| |  __/\__ \   <| || (_) | |_) |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|        \__,_|\___||___/_|\_\\__\___/| .__/
#                                                                          |_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

SYSTEM_DIR="/usr/share/applications"
LOCAL_DIR="$HOME/.local/share/applications"
NOTES_DIR="$HOME/.local/share/system-tracking/applications"

ORANGE='\033[38;2;255;158;23m'
NC='\033[0m'

# Ensure notes directory exists
mkdir -p "$NOTES_DIR"

# Find .desktop files in both directories
monitor_list=$(comm -12 <(ls "$SYSTEM_DIR" 2>/dev/null | sort) <(ls "$LOCAL_DIR" 2>/dev/null | sort))

if [[ -z "$1" ]]; then
    # Show differences
    has_changes=false
    while IFS= read -r app_file; do
        source_file="$SYSTEM_DIR/$app_file"
        test_file="$NOTES_DIR/$app_file"

        if [[ ! -f "$test_file" ]]; then
            has_changes=true
            echo -e "${ORANGE}$app_file${NC}"
            echo " [new file - not yet tracked]"
            echo
        elif ! cmp -s "$source_file" "$test_file"; then
            has_changes=true
            echo -e "${ORANGE}$app_file${NC}"
            delta "$source_file" "$test_file"
            echo
        fi
    done <<< "$monitor_list"

    if ! $has_changes; then
        echo "No changes"
    fi
elif [[ "$1" == "update" ]]; then
    # Update tracked files
    while IFS= read -r app_file; do
        cp "$SYSTEM_DIR/$app_file" "$NOTES_DIR/$app_file"
    done <<< "$monitor_list"
    echo "✓ Tracked files updated"
fi
