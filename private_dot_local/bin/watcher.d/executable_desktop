source "$HOME/.config/shell/lib/format"

SYSTEM_DIR="/usr/share/applications"
LOCAL_DIR="$HOME/.local/share/applications"
NOTES_DIR="$HOME/.local/share/watcher/desktop"

# Ensure notes directory exists.
mkdir -p "$NOTES_DIR"

# Find .desktop files in both directories.
monitor_list=$(comm -12 <(ls "$SYSTEM_DIR" 2>/dev/null | sort) <(ls "$LOCAL_DIR" 2>/dev/null | sort))

if [[ -z "$1" ]]; then
    # Show differences.
    has_changes=false
    while IFS= read -r app_file; do
        source_file="$SYSTEM_DIR/$app_file"
        baseline_file="$NOTES_DIR/$app_file"

        if [[ ! -f "$baseline_file" ]]; then
            has_changes=true
            echo -e "${ORANGE}$app_file${RESET}"
            echo " [new file - not yet tracked]"
            echo
        elif ! cmp -s "$baseline_file" "$source_file"; then
            has_changes=true
            echo -e "${ORANGE}$app_file${RESET}"
            delta "$baseline_file" "$source_file"
            echo
        fi
    done <<< "$monitor_list"

    if ! $has_changes; then
        echo -e "${GREEN}✓${RESET} No change"
    fi
elif [[ "$1" == "resolve" ]]; then
    # Resolve differences.
    has_changes=false
    while IFS= read -r app_file; do
        source_file="$SYSTEM_DIR/$app_file"
        baseline_file="$NOTES_DIR/$app_file"
        local_file="$LOCAL_DIR/$app_file"

        if ! cmp -s "$baseline_file" "$source_file"; then
            has_changes=true
            meld "$source_file" "$local_file"
        fi
    done <<< "$monitor_list"

    if ! $has_changes; then
        echo -e "${GREEN}✓${RESET} No change"
    else
        if gum confirm "Update desktop baseline ?"; then
            while IFS= read -r app_file; do
                cp "$SYSTEM_DIR/$app_file" "$NOTES_DIR/$app_file"
            done <<< "$monitor_list"
            echo "✓ Tracked files updated"
        fi
    fi
elif [[ "$1" == "update" ]]; then
    # Update tracked files.
    if gum confirm "Confirm desktop baseline update"; then
        while IFS= read -r app_file; do
            cp "$SYSTEM_DIR/$app_file" "$NOTES_DIR/$app_file"
        done <<< "$monitor_list"
        echo "✓ Tracked files updated"
    fi
fi
