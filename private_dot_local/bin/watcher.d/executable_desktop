# --- Base set up -----------------------------------------------------------------------

source "$XDG_CONFIG_HOME/shell/lib/format"

script_name=$(basename "$0")

SYSTEM_DIR="/usr/share/applications"
LOCAL_DIR="$XDG_DATA_HOME/applications"
NOTES_DIR="$XDG_DATA_HOME/watcher/desktop"

DESC="Monitor .desktop file changes"

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}watcher $script_name${RESET}"
    printf " [${COLOR_TERM_3}command${RESET}]\n\n"
    printf "watcher $script_name - $DESC\n\n"
    printf "${BOLD}${COLOR_TERM_5}commands:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "" "Check for changes in managed .desktop files"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "resolve" "Resolve differences between managed and source files"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "update" "Update the baseline file"
    exit 0
}

# --- Handling options ------------------------------------------------------------------

LONGOPTS="help"
OPTIONS="h"

PARSED=$(getopt --options=$OPTIONS --longoptions=$LONGOPTS --name "watcher $script_name" -- "$@") || exit 2
eval set -- "$PARSED"

while true; do
    case "$1" in
        -h|--help) show_help ;;
        --) shift; break ;;
        *) echo "Error"; exit 1 ;;
    esac
done

# --- Running main script ---------------------------------------------------------------

# Ensure notes directory exists.
mkdir -p "$NOTES_DIR"

# Find .desktop files in both directories.
monitor_list=$(comm -12 <(fd . "$SYSTEM_DIR" -e .desktop -x echo '{/}' | sort) <(fd . "$LOCAL_DIR" -e .desktop -x echo '{/}' | sort))

if [[ $# -eq 0 ]]; then
    # Show differences.
    has_changes=false
    while IFS= read -r app_file; do
        source_file="$SYSTEM_DIR/$app_file"
        baseline_file="$NOTES_DIR/$app_file"

        if [[ ! -f "$baseline_file" ]]; then
            has_changes=true
            echo -e "${ORANGE}$app_file${RESET}"
            echo " [new file - not yet tracked]"
            echo
        elif ! cmp -s "$baseline_file" "$source_file"; then
            has_changes=true
            echo -e "${ORANGE}$app_file${RESET}"
            delta "$baseline_file" "$source_file"
            echo
        fi
    done <<< "$monitor_list"

    if ! $has_changes; then
        echo -e "${GREEN}✓${RESET} No change"
    fi
elif [[ $# -eq 1 ]]; then
    if [[ "$1" == "resolve" ]]; then
        # Resolve differences.
        has_changes=false
        while IFS= read -r app_file; do
            source_file="$SYSTEM_DIR/$app_file"
            baseline_file="$NOTES_DIR/$app_file"
            local_file="$LOCAL_DIR/$app_file"

            if ! cmp -s "$baseline_file" "$source_file"; then
                has_changes=true
                meld "$source_file" "$local_file"
            fi
        done <<< "$monitor_list"

        if ! $has_changes; then
            echo -e "${GREEN}✓${RESET} No change"
        else
            if gum confirm "Update desktop baseline ?"; then
                while IFS= read -r app_file; do
                    cp "$SYSTEM_DIR/$app_file" "$NOTES_DIR/$app_file"
                done <<< "$monitor_list"
                echo "✓ Tracked files updated"
            fi
        fi
    elif [[ "$1" == "update" ]]; then
        # Update tracked files.
        if gum confirm "Confirm desktop baseline update"; then
            while IFS= read -r app_file; do
                cp "$SYSTEM_DIR/$app_file" "$NOTES_DIR/$app_file"
            done <<< "$monitor_list"
            echo "✓ Tracked files updated"
        fi
    else
		echo "error: invalid command '$1'"
        exit 1
    fi
else
	echo "error: only one operation may be used at a time"
    exit 1
fi
