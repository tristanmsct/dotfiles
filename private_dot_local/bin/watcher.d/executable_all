# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|____ / _` | | |
#  \ V  V / (_| | || (__| | | |  __/ | |_____| (_| | | |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|        \__,_|_|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

# --- Base set up -----------------------------------------------------------------------

source "$XDG_CONFIG_HOME/shell/lib/format"

script_name=$(basename "$0")
WATCHER_DIR="$HOME/.local/bin/watcher.d"

DESC="Run main watchers"

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}watcher $script_name${RESET}"
    printf " [${COLOR_TERM_3}options${RESET}]\n\n"
    printf "watcher $script_name - $DESC\n\n"
    printf "${BOLD}${COLOR_TERM_5}commands:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "" "Run main watchers"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-g, --git" "Performs a git check"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-n, --no-cache" "Omits cache check"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-u, --updates" "Check for updates"
    exit 0
}

# --- Handling options ------------------------------------------------------------------

LONGOPTS="git,help,no-cache,updates"
OPTIONS="ghnu"

PARSED=$(getopt --options=$OPTIONS --longoptions=$LONGOPTS --name "watcher $script_name" -- "$@") || exit 2
eval set -- "$PARSED"

flag_git=n; flag_nocache=n; flag_updates=n;
while true; do
    case "$1" in
        -g|--git) flag_git=y; shift ;;
        -h|--help) show_help ;;
        -n|--no-cache) flag_nocache=y; shift ;;
        -u|--updates) flag_updates=y; shift ;;
        --) shift; break ;;
        *) echo "Error"; exit 1 ;;
    esac
done

# --- Running watchers ------------------------------------------------------------------

section "Chezmoi files and directories"
"$WATCHER_DIR/chezmoi"
echo

section "XDG directories"
"$WATCHER_DIR/xdg"
echo

section ".destkop files"
"$WATCHER_DIR/desktop"
echo

section "Ansible check"
"$WATCHER_DIR/ansible-check"
echo

if [ $flag_nocache == "n" ]; then
    section "System and application caches"
    "$WATCHER_DIR/cache" -s
    echo
fi

if [ $flag_git == "y" ]; then
    section "Git repositories"
    "$WATCHER_DIR/git"
    echo
fi

if [ $flag_updates == "y" ]; then
    section "Available updates"
    "$WATCHER_DIR/updates"
    echo
fi
