# --- Base set up -----------------------------------------------------------------------

source "$XDG_CONFIG_HOME/shell/lib/format"

script_name=$(basename "$0")

CONFIG_BASELINE=$XDG_DATA_HOME/watcher/xdg/config-baseline.txt
STATE_BASELINE=$XDG_DATA_HOME/watcher/xdg/state-baseline.txt
SHARE_BASELINE=$XDG_DATA_HOME/watcher/xdg/share-baseline.txt
CACHE_BASELINE=$XDG_DATA_HOME/watcher/xdg/cache-baseline.txt
HOME_BASELINE=$XDG_DATA_HOME/watcher/xdg/home-baseline.txt

DESC="Monitor xdg directories"

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}watcher $script_name${RESET}"
    printf " [${COLOR_TERM_3}command${RESET}]\n\n"
    printf "watcher $script_name - $DESC\n\n"
    printf "${BOLD}${COLOR_TERM_5}commands:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "" "Check for changes in xdg directories"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "notes" "Manage notes for xdg directories reasons"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "update" "Update the baseline file"
    exit 0
}

# --- Running main script ---------------------------------------------------------------

display_diff() {
	ADDITIONS=$(echo "$1" | grep "^>" | sed 's/^> //')
	DELETIONS=$(echo "$1" | grep "^<" | sed 's/^< //')

	if [[ -n $ADDITIONS ]]; then
		echo "Added:"
		echo "$ADDITIONS"
	fi

	if [[ -n $DELETIONS ]]; then
		echo "Deleted:"
		echo "$DELETIONS"
	fi

	if [[ -z $ADDITIONS && -z $DELETIONS ]]; then
		echo -e "${GREEN}✓${RESET} No change"
	fi
}

if [[ $# -eq 0 ]]; then
	subsection "      .config      "
	DIFF_OUTPUT=$(diff <(cat "$CONFIG_BASELINE") <(fd . "$XDG_CONFIG_HOME" -d 1 -H -x echo '{/}' | sort))
	display_diff "$DIFF_OUTPUT"

	subsection "    .local/state   "
	DIFF_OUTPUT=$(diff <(cat "$STATE_BASELINE") <(fd . "$XDG_STATE_HOME" -d 1 -H -x echo '{/}' | sort))
	display_diff "$DIFF_OUTPUT"

	subsection "    .local/share   "
	DIFF_OUTPUT=$(diff <(cat "$SHARE_BASELINE") <(fd . "$XDG_DATA_HOME" -d 1 -H -x echo '{/}' | sort))
	display_diff "$DIFF_OUTPUT"

	subsection "       .cache      "
	DIFF_OUTPUT=$(diff <(cat "$CACHE_BASELINE") <(fd . "$XDG_CACHE_HOME" -d 1 -H -x echo '{/}' | sort))
	display_diff "$DIFF_OUTPUT"

	DIFF_OUTPUT=$(diff <(cat "$HOME_BASELINE") <(fd . "$HOME" -d 1 -H -x echo '{/}' | sort))
	if [[ -n "$DIFF_OUTPUT" ]]; then
		subsection "       home      "
		ADDITIONS=$(echo "$DIFF_OUTPUT" | grep "^>" | sed 's/^> /+ /')
		DELETIONS=$(echo "$DIFF_OUTPUT" | grep "^<" | sed 's/^< /- /')
		[ -n "$ADDITIONS" ] && echo -e "${RED}$ADDITIONS${RESET}"
		[ -n "$DELETIONS" ] && echo -e "${RED}$DELETIONS${RESET}"
	fi
elif [[ $1 == "notes" ]]; then
	shift
	"$HOME/.local/bin/watcher.d/_xdgnotes" "$@"
elif [[ $# -eq 1 ]]; then
	# --- Handling options --------------------------------------------------------------

	while true; do
		case "$1" in
			-h|--help) show_help ;;
			update)
				if gum confirm "Confirm XDG baseline update"; then
					fd . "$XDG_CONFIG_HOME" -d 1 -H -x echo '{/}' | sort > "$CONFIG_BASELINE"
					fd . "$XDG_STATE_HOME" -d 1 -H -x echo '{/}' | sort > "$STATE_BASELINE"
					fd . "$XDG_DATA_HOME" -d 1 -H -x echo '{/}' | sort > "$SHARE_BASELINE"
					fd . "$XDG_CACHE_HOME" -d 1 -H -x echo '{/}' | sort > "$CACHE_BASELINE"
					fd . "$HOME" -d 1 -H -x echo '{/}' | sort > "$HOME_BASELINE"
				fi
				break
				;;
			*) echo "error: invalid command '$1'"; exit 1 ;;
		esac
	done

else
	echo "error: only one operation may be used at a time"
    exit 1
fi
