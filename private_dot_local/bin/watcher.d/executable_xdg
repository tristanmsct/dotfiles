source "$HOME/.config/shell/lib/format"

CONFIG_BASELINE=$HOME/.local/share/watcher/xdg/config-baseline.txt
STATE_BASELINE=$HOME/.local/share/watcher/xdg/state-baseline.txt
SHARE_BASELINE=$HOME/.local/share/watcher/xdg/share-baseline.txt
CACHE_BASELINE=$HOME/.local/share/watcher/xdg/cache-baseline.txt
HOME_BASELINE=$HOME/.local/share/watcher/xdg/home-baseline.txt

display_diff() {
	ADDITIONS=$(echo "$1" | grep "^>" | sed 's/^> //')
	DELETIONS=$(echo "$1" | grep "^<" | sed 's/^< //')

	if [[ -n $ADDITIONS ]]; then
		echo "Added:"
		echo "$ADDITIONS"
	fi

	if [[ -n $DELETIONS ]]; then
		echo "Deleted:"
		echo "$DELETIONS"
	fi

	if [[ -z $ADDITIONS && -z $DELETIONS ]]; then
		echo "No changes"
	fi
}

if [[ -z $1 ]]; then
	subsection "      .config      "
	DIFF_OUTPUT=$(diff <(cat $CONFIG_BASELINE) <(/usr/bin/ls -1 ~/.config/))
	display_diff "$DIFF_OUTPUT"

	subsection "    .local/state   "
	DIFF_OUTPUT=$(diff <(cat $STATE_BASELINE) <(/usr/bin/ls -1 ~/.local/state/))
	display_diff "$DIFF_OUTPUT"

	subsection "    .local/share   "
	DIFF_OUTPUT=$(diff <(cat $SHARE_BASELINE) <(/usr/bin/ls -1 ~/.local/share/))
	display_diff "$DIFF_OUTPUT"

	subsection "       .cache      "
	DIFF_OUTPUT=$(diff <(cat $CACHE_BASELINE) <(/usr/bin/ls -1 ~/.cache/))
	display_diff "$DIFF_OUTPUT"

	DIFF_OUTPUT=$(diff <(cat $HOME_BASELINE) <(/usr/bin/ls -1a $HOME))
	if [[ -n "$DIFF_OUTPUT" ]]; then
		subsection "       home      "
		ADDITIONS=$(echo "$DIFF_OUTPUT" | grep "^>" | sed 's/^> /+ /')
		DELETIONS=$(echo "$DIFF_OUTPUT" | grep "^<" | sed 's/^< /- /')
		[ -n "$ADDITIONS" ] && echo -e "${RED}$ADDITIONS${RESET}"
		[ -n "$DELETIONS" ] && echo -e "${RED}$DELETIONS${RESET}"
	fi
else
	if [[ $1 == "update" ]]; then
		if gum confirm "Confirm XDG baseline update"; then
			/usr/bin/ls -1 "$HOME/.config" > $CONFIG_BASELINE
			/usr/bin/ls -1 "$HOME/.local/state" > $STATE_BASELINE
			/usr/bin/ls -1 "$HOME/.local/share" > $SHARE_BASELINE
			/usr/bin/ls -1 "$HOME/.cache" > $CACHE_BASELINE
			/usr/bin/ls -1a "$HOME" > $HOME_BASELINE
		fi
	elif [[ $1 == "notes" ]]; then
		shift
		"$HOME/.local/bin/watcher.d/_xdgnotes" "$@"
	fi
fi
