source "$HOME/.config/shell/lib/format"

BASELINE_FILE=$HOME/.local/share/watcher/chezmoi/baseline.txt

# -- Main syncing function --------------------------------------------------------------

chezmoi-sync() {
	DIFF_OUTPUT=$(diff <(cat $BASELINE_FILE) <(chezmoi unmanaged $HOME))
	NOT_TRACKED=$(echo "$DIFF_OUTPUT" | grep "^>" | sed 's/^> //')

	STATUS_OUTPUT=$(chezmoi status)

	if [[ -n "$NOT_TRACKED" ]]; then
		while IFS= read -r line; do
			STATUS_OUTPUT+="\nA  ${line}"
		done <<< "$NOT_TRACKED"
	fi
	STATUS_OUTPUT=$(echo -e "$STATUS_OUTPUT" | sed '/^$/d')  # Remove empty lines.

	if [ -z "$STATUS_OUTPUT" ]; then
		echo "No differences found."
		exit 0
	fi

	echo -e "$STATUS_OUTPUT" | while IFS= read -r line; do
		status="${line:0:2}"
		target_file="${line:3}"

		# Ensure we have an absolute path for chezmoi source-path.
		if [[ "$target_file" != /* ]]; then
			abs_target_file="$HOME/$target_file"
		else
			abs_target_file="$target_file"
		fi

		# Try to get the source path.
		source_file=$(chezmoi source-path "$abs_target_file" 2>/dev/null)

		# Getting extension to manage tempalte files properly.
		filename=$(basename "$source_file")
		extension="${filename##*.}"

		clear
		echo -e "=== File: ${ORANGE}$target_file${RESET} (status: ${GREEN}$status${RESET}) ==="
		if [ -n "$source_file" ]; then
			echo "Source: $source_file"
		fi

		case "$status" in
			D*)
				echo -e "File was ${PURPLE}DELETED from target${RESET}"
				echo -n "Restore file [r], remove from source [d], skip [s], quit [q]? "
				;;
			A*)
				echo -e "File was ${PURPLE}ADDED to target${RESET}"
				echo -n "Add to source [a], delete from target [d], ignore [i], skip [s], quit [q]? "
				;;
			*A)
				echo -e "File was ${PURPLE}ADDED to source${RESET}"
				echo -n "Apply source->target [a], remove from source [d], skip [s], quit [q]? "
				;;
			*M*)
				if [[ "$extension" = "tmpl" && "$status" = "MM" ]]; then
					echo -e "File was ${PURPLE}MODIFIED${RESET} - ${ORANGE}⚠${RESET} source is a ${ORANGE}template${RESET}," \
					 	"target should not be modified directly"
					echo -n "Apply source->target [a], compare source and target [c], skip [s], quit [q]? "
				elif [[ "$extension" = "tmpl" && "$status" = " M" ]]; then
					echo -e "Template was ${PURPLE}MODIFIED${RESET}"
					echo -n "Apply source->target [a], compare source and target [c], skip [s], quit [q]? "
				else
					echo -e "File was ${PURPLE}MODIFIED${RESET}"
					echo -n "Apply source->target [a], re-add target->source [r], compare source and target [c], skip [s], quit [q]? "
				fi
				;;
		esac

		while true; do
			read -r choice < /dev/tty

			case "$status" in
				D*)
					case $choice in
						r|R)
							echo "Restoring $target_file from source..."
							chezmoi apply "$abs_target_file"
							break
							;;
						d|D)
							echo "Removing from source..."
							if [ -n "$source_file" ] && [ -f "$source_file" ]; then
								rm -f "$source_file"
								echo "Removed $source_file"
							else
								chezmoi forget "$abs_target_file"
								echo "Used chezmoi forget for $target_file"
							fi
							break
							;;
						s|S) break ;;
						q|Q) exit 0 ;;
						*) echo -n "Invalid. Use r, d, s, or q: " ;;
					esac
					;;
				*A)
					case $choice in
						a|A)
							echo "Applying $target_file from source to target..."
							chezmoi apply "$abs_target_file"
							break
							;;
						d|D)
							echo "Removing from source..."
							if [ -n "$source_file" ] && [ -f "$source_file" ]; then
								rm -f "$source_file"
								echo "Removed $source_file"
							else
								chezmoi forget "$abs_target_file"
								echo "Used chezmoi forget for $target_file"
							fi
							break
							;;
						s|S) break ;;
						q|Q) exit 0 ;;
						*) echo -n "Invalid. Use a, d, s, or q: " ;;
					esac
					;;
				A*)
					case $choice in
						a|A)
							echo "Adding $target_file to source..."
							chezmoi add "$abs_target_file"
							break
							;;
						d|D)
							echo "Deleting $target_file from target..."
							rm -rf "$abs_target_file"
							break
							;;
						i|I)
							echo "Ignoring $target_file"
							echo $target_file >> $BASELINE_FILE
							{ grep '^\.' $BASELINE_FILE | LC_ALL=C sort; grep -v '^\.' $BASELINE_FILE | LC_ALL=C sort; } | sponge $BASELINE_FILE
							break
							;;
						s|S) break ;;
						q|Q) exit 0 ;;
						*) echo -n "Invalid. Use a, d, i, s, or q: " ;;
					esac
					;;
				*)  # Should always be M
					case $choice in
						a|A)

							echo "Applying $target_file..."
							chezmoi apply "$abs_target_file"
							break
							;;
						r|R)
							if [[ "$extension" = "tmpl" ]]; then
								echo -e "Cannot re-add a modified target to a ${ORANGE}template${RESET}"
								echo -n "Use a, c, s, or q: "
							else
								echo "Re-adding $target_file..."
								chezmoi re-add "$abs_target_file"
								break
							fi
							;;
						c|C)
							chezmoi diff --reverse "$abs_target_file"
							echo
							if [[ "$extension" = "tmpl" ]]; then
								echo -e "delta: ${ORANGE}source${RESET} on the left vs ${ORANGE}target${RESET} on the right."
								echo -n "Apply source->target [a], compare source and target [c], skip [s], quit [q]? "
							else
								echo -e "delta: ${ORANGE}source${RESET} on the left vs ${ORANGE}target${RESET} on the right."
								echo -n "Apply source->target [a], re-add target->source [r], compare source and target [c], skip [s], quit [q]? "
							fi
							;;
						s|S) break ;;
						q|Q) exit 0 ;;
						*)
							if [[ "$extension" = "tmpl" ]]; then
								echo -n "Invalid. Use a, c, s, or q: "
							else
								echo -n "Invalid. Use a, r, c, s, or q: "
							fi
							;;
					esac
					;;
			esac
		done
	done
}

# -- Checking and syncing chezmoi managed directories -----------------------------------

if [[ -z $1 ]]; then
	DIFF_OUTPUT=$(diff <(cat $BASELINE_FILE) <(chezmoi unmanaged $HOME))

	NOT_TRACKED=$(echo "$DIFF_OUTPUT" | grep "^>" | sed 's/^> //')

	STATUS_OUTPUT=$(chezmoi status)

	if [[ -n "$NOT_TRACKED" ]]; then
		while IFS= read -r line; do
			STATUS_OUTPUT+="\nA  ${line}"
		done <<< "$NOT_TRACKED"
		STATUS_OUTPUT=${STATUS_OUTPUT%\\n}
	fi
	STATUS_OUTPUT=$(echo -e "$STATUS_OUTPUT" | sed '/^$/d')  # Remove empty lines.

	if [[ -z $NOT_TRACKED && -z "$STATUS_OUTPUT" ]]; then
		echo "No changes"
		exit 0
	fi

	echo "Changes:"
	if [ -n "$STATUS_OUTPUT" ]; then
		echo -e "$STATUS_OUTPUT" | while IFS= read -r line; do
			echo "$line"
		done
	fi
else
	if [[ $1 == "update" ]]; then
		gum confirm "Confirm chezmoi baseline update" && chezmoi unmanaged $HOME > $BASELINE_FILE
	elif [[ $1 == "sync" ]]; then
		chezmoi-sync
	fi
fi
