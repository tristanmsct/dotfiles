# --- Base set up -----------------------------------------------------------------------

# Needed for when the script is run by pacman.
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}

source "$XDG_CONFIG_HOME/shell/lib/format"

script_name=$(basename "$0")
PACKAGE_INFO_DIR="$XDG_DATA_HOME/watcher/pkglog/"

DESC="Monitor packages meta data"

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}watcher $script_name${RESET}"
    printf " [${COLOR_TERM_3}command${RESET}]\n\n"
    printf "watcher $script_name - $DESC\n\n"
    printf "${BOLD}${COLOR_TERM_5}commands:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "delete" "Delete a package info file"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "diff" "Display the difference between two states"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "notes" "Manage notes for packages reasons"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "query" "Query the package list"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "save" "Save the current state, used as a pacman hook"
    exit 0
}

# -- Helper functions -------------------------------------------------------------------

get_file() {
    local -a options=()
    if [[ $1 = "--multiple" ]]; then
        options+=(--no-limit)
        shift
    elif [[ $1 = "--compare" ]]; then
        options+=(--limit 2)
        shift
    fi

    local selected
    selected=$(fd . "$PACKAGE_INFO_DIR" -x echo '{/}' | sort -r | awk '{
        match($0, /packages_([0-9]{8})_[0-9]+/, arr)
        date = arr[1]
        printf "%s/%s/%s - %s\n", substr(date,1,4), substr(date,5,2), substr(date,7,2), $0
    }' | gum choose "${options[@]}" "$@")

    # Exit if nothing selected.
    [[ -z $selected ]] && return 1

    # Extract and return the original filename(s) with full path.
    while IFS= read -r line; do
        filename=$(awk -F' - ' '{print $2}' <<< "$line")
        echo "${PACKAGE_INFO_DIR}${filename}"
    done <<< "$selected"
}

save_package_list () {
    # Set output directory.

    OUTPUT_FILE="$PACKAGE_INFO_DIR/packages_$(date +%Y%m%d_%H%M%S)"

    # Create output directory.
    mkdir -p "$PACKAGE_INFO_DIR"

    # List all package.
    echo "Collecting all installed packages..."
    declare -A order=([core]=1 [extra]=2 [multilib]=3 [cachyos]=4 [cachyos-v3]=5 [aur]=6)

    # Get list of explicitly installed packages.
    explicit=$(pacman -Qe | awk '{print $1}')

    {
        echo "repository,package,version,install_type"
        {
            pacman -Sl | awk '$4 ~ /^\[installed/ {print $1"|"$2"|"$3}'
            pacman -Qm | while read -r pkg ver; do echo "aur|$pkg|$ver"; done
        } | while IFS='|' read -r repo pkg ver; do
            if echo "$explicit" | grep -q "^${pkg}$"; then
                install_type="explicit"
            else
                install_type="dependency"
            fi
            sortkey=${order[$repo]:-99}
            echo "$sortkey|$repo|$pkg|$ver|$install_type"
        done | sort -t'|' -k1,1n | cut -d'|' -f2- | tr '|' ','
    } > "$OUTPUT_FILE"

    # When the script is run by the pacman hook, it is run as root.
    # This command will transfer the file ownership to my user.
    if [ -n "$SUDO_USER" ]; then
        chown "$SUDO_USER:$SUDO_USER" "$OUTPUT_FILE"
    fi
}

delete_file () {
    while IFS= read -r path; do
        rm "$path"
        echo "Deleted : $path"
    done < <(get_file --multiple --header "Choose files to delete")
}

query_package_list () {
    LONGOPTS="repo:,name:,version:,type:"
    OPTIONS="r:n:v:t:"

    PARSED=$(getopt --options=$OPTIONS --longoptions=$LONGOPTS --name "watcher $script_name query" -- "$@") || exit 2
    eval set -- "$PARSED"

    QUERY=""
    while true; do
        case "$1" in
            -r|--repo) QUERY+="\$1==\"$2\"&&"; shift 2;;
            -n|--name) QUERY+="\$2==\"$2\"&&"; shift 2;;
            -v|--version) QUERY+="\$3==\"$2\"&&"; shift 2;;
            -t|--type) QUERY+="\$4==\"$2\"&&"; shift 2;;
            --) shift; break ;;
            *) echo "Error"; exit 1 ;;
        esac
    done
    shift

    if [ $# -ge 1 ]; then
        echo "error: invalid command '$1'"
        exit 1
    fi
    original_file=$(get_file --header "Choose a file")

    if [[ ! -z "$QUERY" ]]; then
        awk -F',' "${QUERY::-2}" "$original_file" |
            gum table -s',' --columns=Repository,Name,Version,Type --print
    else
        gum table -s',' --columns=Repository,Name,Version,Type --print -f "$original_file"
    fi
}

show_diff () {
    LONGOPTS="choice"
    OPTIONS="c"

    PARSED=$(getopt --options=$OPTIONS --longoptions=$LONGOPTS --name "watcher $script_name diff" -- "$@") || exit 2
    eval set -- "$PARSED"

    choice="n"
    while true; do
        case "$1" in
            -c|--choice) choice="y"; shift ;;
            --) shift; break ;;
            *) echo "Error"; exit 1 ;;
        esac
    done
    shift

    if [ $# -ge 1 ]; then
        echo "error: invalid command '$1'"
        exit 1
    fi

    if [[ $choice = "y" ]]; then
        readarray -t paths < <(get_file --compare --header "Pick two states to compare")

        if [[ ${#paths[@]} -ne 2 ]]; then
            echo "Error: you need to select two files ${#paths[@]}" >&2
            exit 1
        fi

        file1="${paths[0]}"
        file2="${paths[1]}"
    else
        read -r file1 file2 <<< "$(fd . "$PACKAGE_INFO_DIR" -x echo '{/}' | sort -r | head -2 | tr '\n' ' ')"
        file1="$PACKAGE_INFO_DIR/$file1"
        file2="$PACKAGE_INFO_DIR/$file2"
    fi

    awk -F',' 'NR>1 {print $1","$2","$4}' "$file1" | sort > /tmp/new.tmp
    awk -F',' 'NR>1 {print $1","$2","$4}' "$file2" | sort > /tmp/old.tmp

    echo -e "=== ${GREEN}Only in old (deleted)${RESET} ==="
    comm -23 /tmp/old.tmp /tmp/new.tmp | gum table -s',' --columns=Repository,Name,Type --print
    echo

    echo -e "=== ${GREEN}Only in new (added)${RESET} ==="
    comm -13 /tmp/old.tmp /tmp/new.tmp | gum table -s',' --columns=Repository,Name,Type --print
    echo

    echo -e "=== ${GREEN}Installation type changed${RESET} ==="
    # Get packages in both files (by repo,name only).
    awk -F',' 'NR>1 {print $1","$2}' "$file1" | sort > /tmp/new_keys.tmp
    awk -F',' 'NR>1 {print $1","$2}' "$file2" | sort > /tmp/old_keys.tmp

    # Find common packages.
    comm -12 /tmp/old_keys.tmp /tmp/new_keys.tmp | while read -r key; do
        old_line=$(grep "^$key," /tmp/old.tmp)
        new_line=$(grep "^$key," /tmp/new.tmp)
        if [ "$old_line" != "$new_line" ]; then
            repo=$(echo "$key" | cut -d',' -f1)
            name=$(echo "$key" | cut -d',' -f2)
            old_type=$(echo "$old_line" | cut -d',' -f3)
            new_type=$(echo "$new_line" | cut -d',' -f3)
            echo "$repo,$name,$old_type,$new_type"
        fi
    done | gum table -s',' --columns="Repository,Name,Old Type,New Type" --print
}

# -- Running main script ----------------------------------------------------------------

if [[ $1 == "notes" ]]; then
    shift
    "$HOME/.local/bin/watcher.d/_pkgnotes" "$@"
elif [[ $# -eq 0 ]]; then
    echo "error: command expected"
    exit 1
else
    case $1 in
        -h|--help) show_help ;;
        save)
            save_package_list
            ;;
        query)
            query_package_list "$@"
            ;;
        diff)
            show_diff "$@"
            ;;
        delete)
            delete_file
            ;;
        *)
            echo "error: invalid option or command '$1'"
            exit 1
            ;;
    esac
fi
