#!/usr/bin/env bash
#                _       _                          _ _
# __      ____ _| |_ ___| |__   ___ _ __       __ _(_) |_
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|____ / _` | | __|
#  \ V  V / (_| | || (__| | | |  __/ | |_____| (_| | | |_
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|        \__, |_|\__|
#                                             |___/
#
# -----------------------------------------------------------------------------------------------------------------------------------------
# Check all local repos for local and remote changes.
# -----------------------------------------------------------------------------------------------------------------------------------------

# --- Base set up -----------------------------------------------------------------------

source "$XDG_CONFIG_HOME/shell/lib/format"

script_name=$(basename "$0")

DESC="Check git repositories status"

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}watcher $script_name${RESET}"
    printf " [${COLOR_TERM_3}command${RESET}]\n\n"
    printf "watcher $script_name - $DESC\n\n"
    printf "${BOLD}${COLOR_TERM_5}available commands:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "" "Check git repositories status"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-a, --aur" "Check custom packge recipes repositories"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-p, --projects" "Check personal projects repositories"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-s, --system" "Check system repositories"
    exit 0
}

# --- Handling options ------------------------------------------------------------------

LONGOPTS="help,system,aur,projects"
OPTIONS="hsap"

# TODO : autocomplete
PARSED=$(getopt --options=$OPTIONS --longoptions=$LONGOPTS --name "watcher $script_name" -- "$@") || exit 2
eval set -- "$PARSED"

system=n
aur=n
projects=n
while true; do
    case "$1" in
        -h|--help) show_help ;;
        -s|--system) system=y; shift ;;
        -a|--aur) aur=y; shift ;;
        -p|--projects) projects=y; shift ;;
        --) shift; break ;;
        *) echo "Error"; exit 1 ;;
    esac
done

if [ $system = "n" ] && [ $aur = "n" ] && [ $projects = n ]; then
    system=y
    aur=y
    projects=y
fi

if [ $# -ge 1 ]; then
	echo "error: invalid option or command '$1'"
    exit 1
fi

# -- Gathering the lists of all repositories to check -----------------------------------

# Main repo, config files and such.
lst_repos_system=("$XDG_DATA_HOME/dotfiles")
lst_repos_system+=("$XDG_DATA_HOME/ansible-archlinux")

# The main hub for repos.
base_repos="$HOME/Nextcloud/02-Projets/01-Repos"
public_repos="$HOME/Nextcloud/02-Projets/02-Public"
aur_repos="$XDG_DATA_HOME/aur"

# Add base repos
if [[ -d "$base_repos" ]]; then
    readarray -t base_dirs < <(ls -1d "$base_repos"/*/ 2>/dev/null)
    lst_repos_projects=("${base_dirs[@]}")
fi

# Add public repos.
if [[ -d "$public_repos" ]]; then
    readarray -t public_dirs < <(ls -1d "$public_repos"/*/ 2>/dev/null)
    lst_repos_projects+=("${public_dirs[@]}")
fi

# Other repos.
lst_repos_projects+=("$HOME/Nextcloud/01-Travail/05-OpenClassrooms/01-OC_Projets"
    "$HOME/Nextcloud/01-Travail/05-OpenClassrooms/98-OC_Manager")

lst_repos_aur=()
# Add aur repos.
if [[ -d "$aur_repos" ]]; then
    readarray -t base_dirs < <(ls -1d "$aur_repos"/*/ 2>/dev/null)
    lst_repos_aur=("${base_dirs[@]}")
fi

# -- Main checking function -------------------------------------------------------------

check-repo() {
    # We go from repo to repo because we cannot run git commands from outside.
    # The update is necessary to get the changes.
    current_repo=$1
    cd "$current_repo" || exit
    git remote update &> /dev/null

    # Splitting the path by '/' to keep only the last bit, this gives a more readable display at the end.
    IFS='/' read -r -a path_repo <<< "$current_repo"
    repo_dir=${path_repo[${#path_repo[@]} - 1]}

    # The `clean` variable is initialised with a value of 0 and incremented depending of the repos status.
    # Local changes -> +1
    # Remote changes -> +2
    # This gives four different possible states for the repo.
    clean=0

    if ! (git status|grep -q "working tree clean"); then clean=$((clean+1)); fi;
    if (git status|grep -q "Your branch is behind"); then clean=$((clean+2)); fi;

    case "$clean" in

        0) echo -e "Repo ${PURPLE}$repo_dir${RESET} is ${GREEN}up to date${RESET}."
            ;;
        1) echo -e "Repo ${PURPLE}$repo_dir${RESET} has ${BLUE}local${RESET} changes."
            ;;
        2) echo -e "Repo ${PURPLE}$repo_dir${RESET} has ${ORANGE}remote${RESET} changes."
            ;;
        3) echo -e "Repo ${PURPLE}$repo_dir${RESET} has ${BLUE}local${RESET} and ${ORANGE}remote${RESET} changes."
        ;;
        *) echo "🍞 Something went really wrong."
        ;;
    esac
}

# -- Permorming all checks --------------------------------------------------------------

# Checking if the ssh identity is already added, otherwise it will be prompted everytime.
if ! (ssh-add -l|grep -q "github (ED25519)"); then ssh-add -t 1h "$HOME/.ssh/github_ed25519"; fi;

if [ $system = "y" ]; then
    subsection "System repositories"
    for repo in "${lst_repos_system[@]}"; do
        check-repo "$repo"
    done
fi

if [ $aur = "y" ]; then
    subsection "Aur repositories"
    for repo in "${lst_repos_aur[@]}"; do
        check-repo "$repo"

        pkgname=$(grep -oP '^pkgname=\K.*' PKGBUILD | tr -d '"'"'")

        # Check if package is installed.
        if pacman -Q "$pkgname" &>/dev/null; then
            last_install_date=$(date -u -d """$(LC_ALL=C pacman -Qi "$pkgname" | awk -F': ' '/^Install Date/{print $2}')""" +%Y-%m-%dT%H:%M:%SZ)

            url=$(grep -oP '^url=\K.*' PKGBUILD | tr -d '"'"'")
            owner_repo=$(awk -F'/' '{print $(NF-1)"/"$NF}' <<< "$url")
            last_upstream_commit=$(curl -s "https://api.github.com/repos/$owner_repo/commits/HEAD" | jq -r .commit.committer.date)

            if [[ $last_upstream_commit > $last_install_date ]]; then
                echo -e "Upstream repository ${ORANGE}has changes${RESET}"
            fi

            current=$(pacman -Q "$pkgname" 2>/dev/null | cut -d' ' -f2)

            makepkg -od &>/dev/null
            new=$(makepkg --packagelist 2>/dev/null | head -n1 | xargs basename | sed "s/${pkgname}-//" | sed 's/-[^-]*-[^-]*\.pkg\.tar\.zst//')

            # Remove trailing dash followed by digits from version strings using
            # parameter expansion instead of external sed calls.
            current="${current%-[0-9]*}"
            new="${new%-[0-9]*}"

            if [ "$current" != "$new" ] && [ -n "$new" ]; then
                echo -e "Package recipe ${ORANGE}update available${RESET}: $current -> $new"
            fi
        fi
    done
fi

if [ $projects = "y" ]; then
    subsection "Projects repositories"
    for repo in "${lst_repos_projects[@]}"; do
        check-repo "$repo"
    done
fi
