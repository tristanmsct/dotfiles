#!/usr/bin/env bash
#              _
#   __ _ _ __ (_)_ __ ___
#  / _` | '_ \| | '_ ` _ \
# | (_| | | | | | | | | | |
#  \__,_|_| |_|_|_| |_| |_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------
# Wrapper for common terminal animations.
# -----------------------------------------------------------------------------------------------------------------------------------------

source "$XDG_CONFIG_HOME/shell/lib/format"

script_name=$(basename "$0")

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}$script_name${RESET}"
    printf " [${COLOR_TERM_3}command${RESET}]\n\n"
    printf "$script_name - A simple wrapper for terminal animations\n\n"
    printf "${BOLD}${COLOR_TERM_5}options:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "cava" "Starts cava audio visualiser"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "aqua" "Starts asciiquarium"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "matrix" "Starts cmatrix"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "bonsai" "Starts cbonsai"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    exit 0
}

if [[ -z $1 ]]; then
    choice=$(gum choose "cava" "aqua" "matrix" "bonsai")
else
    choice=$1
fi


case $choice in
    cava)
        cava "${@:2}"
        ;;
    aqua)
        asciiquarium -t "${@:2}"
        ;;
    matrix)
        neo-matrix -D --charset=ascii "${@:2}"
        ;;
    bonsai)
        cbonsai -li "${@:2}"
        ;;
    -h|--help)
        show_help
        ;;
    *)
        echo "Unknown command."
        ;;
esac
