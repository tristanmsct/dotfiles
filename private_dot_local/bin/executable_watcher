#!/usr/bin/env bash
#                _       _
# __      ____ _| |_ ___| |__   ___ _ __
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|
#  \ V  V / (_| | || (__| | | |  __/ |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

# TODO
# system-tracking dir should be renamed.
# watcher config should also monitor local/state and local/share I think.

WATCHER_DIR="$HOME/.local/bin"

GREEN='\033[38;2;125;235;103m'
NC='\033[0m'

# If no args or help requested
if [[ -z "$1" ]] || [[ "$1" =~ ^(-h|--help|help)$ ]]; then
    echo "watcher - System monitoring toolkit"
    echo
    echo "Available commands:"
    for script in "$WATCHER_DIR"/watcher-*; do
        [[ -x "$script" ]] && basename "$script" | sed 's/^watcher-/  /'
    done
    echo
    echo "Usage: watcher <command> [args]"
    exit 0
fi

# "Open" and "all" commands do not need a stand alone script
if [[ "$1" = "open" ]]; then
    xdg-open $HOME/.local/share/system-tracking > /dev/null 2>&1 & disown
    exit 1
elif [[ "$1" = "all" ]]; then
    echo -e "=== ${GREEN}Chezmoi monitored files and directories${NC} ==="
    "$WATCHER_DIR/watcher-chezmoi"
    echo

    echo -e "=== ${GREEN}XDG directories${NC} ==="
    "$WATCHER_DIR/watcher-xdg"
    echo

    echo -e "=== ${GREEN}.destkop files${NC} ==="
    "$WATCHER_DIR/watcher-desktop"
    echo

    echo -e "=== ${GREEN}AUR custom PKGFILE${NC} ==="
    "$WATCHER_DIR/watcher-aur"
    echo

    echo -e "=== ${GREEN}Git repositories${NC} ==="
    "$WATCHER_DIR/watcher-git"
    echo

    exit 1
else
    # Dispatch to watcher-<command>
    target="$WATCHER_DIR/watcher-$1"

    if [[ -x "$target" ]]; then
        shift
        exec "$target" "$@"
    else
        echo "Error: watcher-$1 not found"
        echo "Run 'watcher' to see available commands"
        exit 1
    fi
fi
