#!/usr/bin/env bash
#                _       _
# __      ____ _| |_ ___| |__   ___ _ __
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|
#  \ V  V / (_| | || (__| | | |  __/ |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

# Get the script name.
script_name=$(basename "$0")

WATCHER_DIR="$HOME/.local/bin"

GREEN='\033[38;2;125;235;103m'
BOLD='\033[1m'
RESET='\033[0m'

section()  { echo -e "=== ${BOLD}${GREEN}$1${RESET} ==="; }

# Message to be displayed as help.
show_help() {
    echo "watcher - System monitoring toolkit"
    echo "Usage: $script_name <command> [args]"
    echo
    echo "Available commands:"
    for script in "$WATCHER_DIR"/watcher-*; do
        [[ -x "$script" ]] && basename "$script" | sed 's/^watcher-/  /'
    done
    echo -e "  open\t\t opens the dedicated watcher directory"
    echo -e "  -h, --help\t display this help message"
    echo
    exit 0
}

has_flag() {
    local args=("$@")
    local flags=()
    local divider_found=false

    for arg in "${args[@]}"; do
        if [[ "$arg" == "--" ]]; then
            divider_found=true
            continue
        fi
        if $divider_found; then
            flags+=("$arg")
        fi
    done

    for passed in "${args[@]}"; do
        [[ "$passed" == "--" ]] && break
        for flag in "${flags[@]}"; do
            [[ "$passed" == "$flag" ]] && return 0
        done
    done
    return 1
}

if has_flag "$@" -- -c --cache -f --full; then
    echo "cache mode"
fi

if [[ $# -eq 0 ]]; then
    show_help
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        open)
            xdg-open $HOME/.local/share/system-tracking > /dev/null 2>&1 & disown
            exit 1
            ;;
        all)
            section "Chezmoi monitored files and directories"
            "$WATCHER_DIR/watcher-chezmoi"
            echo

            section "XDG directories"
            "$WATCHER_DIR/watcher-xdg"
            echo

            section ".destkop files"
            "$WATCHER_DIR/watcher-desktop"
            echo

            if has_flag "$@" -- -c --cache; then
                section "Caches"
                "$WATCHER_DIR/watcher-cache"
                echo
            fi

            if ! has_flag "$@" -- -n --nogit; then
                section "AUR custom PKGFILE"
                "$WATCHER_DIR/watcher-aur"
                echo

                section "Git repositories"
                "$WATCHER_DIR/watcher-git"
                echo
            fi

            exit 1
            ;;
        *)
            # Dispatch to watcher-<command>
            target="$WATCHER_DIR/watcher-$1"

            if [[ -x "$target" ]]; then
                shift
                exec "$target" "$@"
                exit 1
            else
                echo "Error: watcher-$1 not found"
                echo "Run 'watcher' to see available commands"
                exit 1
            fi
    esac
done
