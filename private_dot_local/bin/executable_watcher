#!/usr/bin/env bash
#                _       _
# __      ____ _| |_ ___| |__   ___ _ __
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|
#  \ V  V / (_| | || (__| | | |  __/ |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

# --- Base set up -----------------------------------------------------------------------

source "$HOME/.config/shell/lib/format"

script_name=$(basename "$0")
WATCHER_DIR="$HOME/.local/bin/watcher.d"

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}$script_name${RESET}"
    printf " <${COLOR_TERM_3}command${RESET}> [${COLOR_TERM_3}options${RESET}] [${COLOR_TERM_3}...${RESET}]\n\n"
    printf "$script_name - System monitoring toolkit\n\n"
    printf "${BOLD}${COLOR_TERM_5}commands:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "all" "Run main watchers"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "ansible-check" "Check for difference in wanted and installed packages"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "aur" "Check for custom AUR packages changes"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "cache" "Check for caches"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "chezmoi" "Track chezmoi-managed files"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "desktop" "Monitor .desktop file changes"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "git" "Check git repositories status"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "open" "Open the system notes directory"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "pacnotes" "Manage package notes"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "pkglog" "Collect packages logs"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "sysinfo" "Collect system information"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "updates" "Check for available updates"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "xdg" "Monitor xdg directories"
    exit 0
}

# --- Running watcher -------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help|help)
            show_help
            ;;
        open)
            xdg-open $HOME/.local/share/watcher > /dev/null 2>&1 & disown
            exit 0
            ;;
        *)
            # Dispatch to watcher plugin.
            target="$WATCHER_DIR/$1"

            if [[ -x "$target" ]]; then
                shift
                exec "$target" "$@"
                exit 0
            else
        		echo "error: invalid command '$1'"
                echo "run 'watcher --help' to see available commands"
                exit 1
            fi
    esac
done

# If we reach here, no command or option was provided.
show_help
