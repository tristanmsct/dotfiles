#!/usr/bin/env bash
#                _       _
# __      ____ _| |_ ___| |__   ___ _ __
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|
#  \ V  V / (_| | || (__| | | |  __/ |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

source "$HOME/.config/shell/lib/format"

# Get the script name.
script_name=$(basename "$0")

WATCHER_DIR="$HOME/.local/bin/watcher.d"

# Message to be displayed as help.
show_help() {
    echo "watcher - System monitoring toolkit"
    echo "Usage: $script_name <command> [args]"
    echo
    echo "Available commands:"
    echo -e "  all\t\t -- Run main watchers"
    echo -e "  aur\t\t -- Check for custom AUR packages changes"
    echo -e "  cache\t\t -- Check for caches"
    echo -e "  chezmoi\t -- Track chezmoi-managed files"
    echo -e "  desktop\t -- Monitor .desktop file changes"
    echo -e "  git\t\t -- Check git repositories status"
    echo -e "  open\t\t -- Open the system notes directory"
    echo -e "  pacnotes\t -- Manage package notes"
    echo -e "  pkglog\t -- Collect packages logs"
    echo -e "  sysinfo\t -- Collect system information"
    echo -e "  xdg\t\t -- Monitor xdg directories"
    echo -e "  -h, --help\t -- Display this help message"
    echo
    exit 0
}

has_flag() {
    local args=("$@")
    local flags=()
    local divider_found=false

    for arg in "${args[@]}"; do
        if [[ "$arg" == "--" ]]; then
            divider_found=true
            continue
        fi
        if $divider_found; then
            flags+=("$arg")
        fi
    done

    for passed in "${args[@]}"; do
        [[ "$passed" == "--" ]] && break
        for flag in "${flags[@]}"; do
            [[ "$passed" == "$flag" ]] && return 0
        done
    done
    return 1
}

if [[ $# -eq 0 ]]; then
    show_help
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        open)
            xdg-open $HOME/.local/share/watcher > /dev/null 2>&1 & disown
            exit 1
            ;;
        all)
            section "Chezmoi monitored files and directories"
            "$WATCHER_DIR/chezmoi"
            echo

            section "XDG directories"
            "$WATCHER_DIR/xdg"
            echo

            section ".destkop files"
            "$WATCHER_DIR/desktop"
            echo

            if has_flag "$@" -- -c --cache; then
                section "System and application caches"
                "$WATCHER_DIR/cache"
                echo
            fi

            if ! has_flag "$@" -- -n --nogit; then
                section "Git repositories"
                "$WATCHER_DIR/git" --aur
                echo
            fi

            exit 1
            ;;
        *)
            # Dispatch to watcher plugin.
            target="$WATCHER_DIR/$1"

            if [[ -x "$target" ]]; then
                shift
                exec "$target" "$@"
                exit 1
            else
                echo "Error: $1 not found"
                echo "Run 'watcher' to see available commands"
                exit 1
            fi
    esac
done
