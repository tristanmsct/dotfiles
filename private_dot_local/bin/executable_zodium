#!/usr/bin/env bash
#               _ _
#  _______   __| (_)_   _ _ __ ___
# |_  / _ \ / _` | | | | | '_ ` _ \
#  / / (_) | (_| | | |_| | | | | | |
# /___\___/ \__,_|_|\__,_|_| |_| |_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

if [ $# -eq 0 ]; then
    target="$HOME"
else
    target=$(zoxide query --list | fzf --filter "$@" | head -1 2>/dev/null)
    if [ -z "$target" ]; then
        target="$HOME"
    fi
fi
codium.sh $target > /dev/null 2>&1 & disown
