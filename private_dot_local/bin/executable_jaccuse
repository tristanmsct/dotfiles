"""
Created on 2026-04-05.

@author: Tristan Muscat
@email: tristan.muscat@pm.me

For example, all these depend on gtk4.
jaccuse -d "adw-bluetooth baobab gnome-calculator gnome-calendar gnome-podcasts smile libadwaita libinput-gestures pinta nmrs
proton-vpn-cli pika-backup simple-scan steam mission-center pavucontrol nautilus"
"""
import subprocess
import sys
import argparse
import networkx as nx
import re

# ANSI color codes
ORANGE = "\033[38;2;255;158;23m"
GREEN = "\033[38;2;30;220;60m"
PURPLE = "\033[38;2;150;85;166m"
RESET = "\033[0m"


def parse_args():
    """Parse command line arguments"""
    parser = argparse.ArgumentParser(description="Dependency surveillance tool")

    # Flags.
    parser.add_argument("-c", "--chain", action="store_true", help="Look up the dependency chain between a package and a target")
    parser.add_argument("-d", "--deep", action="store_true", help="Deep search")
    parser.add_argument("-q", "--quiet", action="store_true", help="Quiet mode")
    parser.add_argument("-r", "--reverse", action="store_true", help="Show reverse dependencies")
    parser.add_argument("-u", "--only-uninstall", action="store_true", help="Displays only potentially orphaned dependencies")

    # Optional positional package argument.
    parser.add_argument("package", nargs="?", help="Package name")
    parser.add_argument("target", nargs="?", help="Package name")

    return parser.parse_args()


def pick_package():
    """Pick a package interactively using gum filter"""
    try:
        # Get full list of installed packages.
        lst_all_packages = subprocess.run(["pacman", "-Qq"], stdout=subprocess.PIPE, text=True, check=True)

        # Get a selection of package.
        gum_result = subprocess.run(
            ["gum", "filter", "--placeholder", "Search packages...", "--no-limit"],
            input=lst_all_packages.stdout,  # Pass as stdin, not as argument.
            stdout=subprocess.PIPE,
            text=True,
            check=True,
        )

        package = gum_result.stdout.strip().split("\n")

        if package:
            return package
        else:
            print("No package selected", file=sys.stderr)
            sys.exit(1)

    except subprocess.CalledProcessError:
        print("Exiting", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print("Error: Command not found. Make sure 'gum' is installed.", file=sys.stderr)
        sys.exit(1)


def create_repr_list_packages(lst_packages):
    """Create a string representation for a list of packages"""
    repr_list_package = ""
    for package in lst_packages:
        if package == lst_packages[-1]:
            repr_list_package += f" and {PURPLE}{package}{RESET}"
        else:
            repr_list_package += f", {PURPLE}{package}{RESET}"

    return repr_list_package.strip(", ").strip(" and ")


def get_explicit_dependents(lst_packages):
    """Find explicitly installed packages that require the given package"""
    # If even one package is misspelled, we throw an error, it is safer.
    try:
        lst_of_set_of_dependents = []
        for package in lst_packages:
            # Get reverse dependencies (packages that require this one).
            pactree_result = subprocess.run(["pactree", "-r", "-u", package], stdout=subprocess.PIPE, text=True, check=True)
            set_dependents = set(pactree_result.stdout.strip().split("\n")[1:])  # The first line of pactree is the package itself.
            set_dependents = {dep.strip() for dep in set_dependents if dep.strip()}

            # Get explicitly installed packages.
            pacman_result = subprocess.run(["pacman", "-Qeq"], stdout=subprocess.PIPE, text=True, check=True)
            set_explicit_pkgs = set(pacman_result.stdout.strip().split("\n"))

            # We keep only the intersection of the dependents and the explictly installed packages.
            lst_of_set_of_dependents.append(set_dependents & set_explicit_pkgs)

        # We finally get the intersection of all the lists of sets of dependents.
        final_set = set.intersection(*lst_of_set_of_dependents)

        repr_list_package = create_repr_list_packages(lst_packages)

        # Display results.
        if final_set:
            print(f"List of {GREEN}explicitly installed packages{RESET} that require {repr_list_package}:")
            for dep in final_set:
                print(f"{GREEN}{dep}{RESET}")
        else:
            suffix = ("is not a dependency" if len(lst_packages) == 1 else "are not dependencies")
            print(f"{repr_list_package} {suffix} of any common explicitly installed package.")

        return final_set

    except subprocess.CalledProcessError:
        print(f"Error: Could not process package '{package}'", file=sys.stderr)
        sys.exit(1)


def find_full_list_of_dependencies(lst_packages, deep_search=False):
    """Find the full list of dependencies for a list of packages"""
    # If even one package is misspelled, we throw an error, it is safer.
    try:
        full_set_dependencies = set()
        for package in lst_packages:
            pactree_cmd = ["pactree", "-u"]
            if not deep_search:
                pactree_cmd.append("-d 1")
            pactree_cmd.append(package)

            lst_dependencies = subprocess.run(pactree_cmd, stdout=subprocess.PIPE, text=True, check=True)
            lst_dependencies = set(lst_dependencies.stdout.strip().split("\n")[1:])
            lst_dependencies = {dep.strip() for dep in lst_dependencies if dep.strip()}
            lst_dependencies = {dep.split("=")[0].strip(">") for dep in lst_dependencies}

            full_set_dependencies.update(lst_dependencies)

    except subprocess.CalledProcessError:
        print(f"Error: Could not process package '{package}'", file=sys.stderr)
        sys.exit(1)

    return full_set_dependencies


def get_potential_orphans(lst_packages, deep_search=False, quiet=False, only_uninstall=False):
    """Get list of potential orphans if uninstalling a list of packages"""
    full_set_dependencies = find_full_list_of_dependencies(lst_packages, deep_search)
    repr_list_package = create_repr_list_packages(lst_packages)

    if not full_set_dependencies:
        suffix = ("does not" if len(lst_packages) == 1 else "do not")
        print(f"{repr_list_package} {suffix} does not have any dependency")
    else:
        ct_orph = 0
        ct_req = 0
        if not quiet:
            print(f"List of dependencies for {repr_list_package} ({GREEN}would be uninstalled{RESET} and {ORANGE}would remain{RESET}):")
        for depencency in full_set_dependencies:
            lst_reqs_of_dependency = subprocess.run(
                ["pactree", "-u", "-r", depencency],
                stdout=subprocess.PIPE,
                text=True,
                check=True,
            )
            lst_reqs_of_dependency = set(lst_reqs_of_dependency.stdout.strip().split("\n")[1:])
            lst_reqs_of_dependency = {dep.strip() for dep in lst_reqs_of_dependency if dep.strip()}
            lst_reqs_of_dependency = {dep.split("=")[0].strip(">") for dep in lst_reqs_of_dependency}

            if lst_reqs_of_dependency - full_set_dependencies - set(lst_packages):
                if not quiet and not only_uninstall:
                    print(f"{ORANGE}{depencency}{RESET}")
                ct_req += 1
            else:
                if not quiet:
                    print(f"{GREEN}{depencency}{RESET}")
                ct_orph += 1

        str_output = f"Out of {ct_orph + ct_req} dependencies, {GREEN}{ct_orph}{RESET} "
        str_output += f"packages would be uninstalled, {ORANGE}{ct_req}{RESET} would remain."
        print(str_output)


def keep_maximal_paths(list_of_paths):
    as_sets = [frozenset(x) for x in list_of_paths]
    result = []
    for i, s in enumerate(as_sets):
        is_subset = any(
            s < as_sets[j] or (s == as_sets[j] and i > j)
            for j in range(len(as_sets)) if j != i
        )
        if not is_subset:
            result.append(list_of_paths[i])
    return result


def get_dependency_chain(package, target, deep_search=False):
    """Get a dependency chain for a package to a target"""
    try:
        dep_chain = subprocess.run(["pactree", "-g", package], stdout=subprocess.PIPE, text=True, check=True)
        # Dependency chains are in the form
        # digraph G { START [color=red, style=filled];
        # node [style=filled, color=green];
        #  "START" -> "nmrs";
        # "nmrs" -> "gtk4" [color=chocolate4];
        # "gtk4" -> "adwaita-fonts" [color=chocolate4];
    except subprocess.CalledProcessError:
        sys.exit(1)

    # Creating a networkx graph which is much more manageable for the rest of the program.
    graph_deps = nx.DiGraph()
    for line in dep_chain.stdout.split("\n"):
        match_dep = re.match(r'\s?"(.+?)".*->.*"(.+?)"', line)
        if match_dep:
            graph_deps.add_edge(match_dep.group(1), match_dep.group(2))

    try:
        lst_paths = nx.all_simple_paths(graph_deps, "START", target, 10)

        # Creating a list of longest paths between the package and the target with only once each direct dependency.
        # This way, these two paths are considered duplicates and we only keep the longest which inlcude the shortest.
        # nmrs -> gtk4 -> xdg-desktop-portal-gtk -> xdg-desktop-portal -> systemd
        # nmrs -> libadwaita -> gtk4 -> xdg-desktop-portal-gtk -> xdg-desktop-portal -> systemd
        lst_paths = [path[1:] for path in lst_paths]
        if not deep_search:
            lst_paths = keep_maximal_paths(lst_paths)

        if lst_paths:
            for v in lst_paths:
                v[0] = f"""{GREEN}{v[0]}{RESET}"""
                v[-1] = f"""{ORANGE}{v[-1]}{RESET}"""
                print(" -> ".join(v))
        else:
            print(f"No dependency chain between {package} and {target}")

    except nx.NetworkXNoPath:
        print(f"No dependency chain between {package} and {target}")


def main(args):
    """Get a list of packages and perform a normal or reverse search of dependencies"""
    if not (lst_packages := args.package):
        lst_packages = pick_package()
    else:
        lst_packages = lst_packages.split(" ")

    if args.chain:
        if not args.target:
            args.target = pick_package()[0]
        get_dependency_chain(lst_packages[0], args.target, deep_search=args.deep)
    elif args.reverse:
        get_explicit_dependents(lst_packages)
    else:
        get_potential_orphans(lst_packages, deep_search=args.deep, quiet=args.quiet, only_uninstall=args.only_uninstall)


if __name__ == "__main__":
    args = parse_args()
    main(args)
