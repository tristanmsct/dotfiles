#!/usr/bin/env bash
#      _ _   _
#  ___(_) |_| |_ _   _
# |_  / | __| __| | | |
#  / /| | |_| |_| |_| |
# /___|_|\__|\__|\__, |
#                |___/
#
# -----------------------------------------------------------------------------------------------------------------------------------------

if [ $# -eq 0 ]; then
    target="$HOME"
else
    target=$(zoxide query --list | fzf --filter "$*" | head -1 2>/dev/null)
    if [ -z "$target" ]; then
        target="$HOME"
    fi
fi
kitty "$target" > /dev/null 2>&1 & disown
