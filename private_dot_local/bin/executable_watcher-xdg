#!/usr/bin/env bash
#                _       _                           _
# __      ____ _| |_ ___| |__   ___ _ __    __  ____| | __ _
# \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|___\ \/ / _` |/ _` |
#  \ V  V / (_| | || (__| | | |  __/ | |_____>  < (_| | (_| |
#   \_/\_/ \__,_|\__\___|_| |_|\___|_|      /_/\_\__,_|\__, |
#                                                      |___/
#
# -----------------------------------------------------------------------------------------------------------------------------------------

CONFIG_BASELINE=$HOME/.local/share/system-tracking/config-baseline.txt
STATE_BASELINE=$HOME/.local/share/system-tracking/state-baseline.txt
SHARE_BASELINE=$HOME/.local/share/system-tracking/share-baseline.txt

CYAN="\033[38;2;105;230;245m"
BOLD='\033[1m'
RESET='\033[0m'

section()  { echo -e "\n${BOLD}${CYAN}▶ $1${RESET}"; }


display_diff() {
	ADDITIONS=$(echo "$1" | grep "^>" | sed 's/^> //')
	DELETIONS=$(echo "$1" | grep "^<" | sed 's/^< //')

	if [[ -n $ADDITIONS ]]; then
		echo "Added:"
		echo "$ADDITIONS"
	fi

	if [[ -n $DELETIONS ]]; then
		echo "Deleted:"
		echo "$DELETIONS"
	fi

	if [[ -z $ADDITIONS && -z $DELETIONS ]]; then
		echo "No changes"
	fi
}

if [[ -z $1 ]]; then
	section "      .config      "
	DIFF_OUTPUT=$(diff <(cat $CONFIG_BASELINE) <(/usr/bin/ls -1 ~/.config/))
	display_diff "$DIFF_OUTPUT"

	section "    .local/state   "
	DIFF_OUTPUT=$(diff <(cat $STATE_BASELINE) <(/usr/bin/ls -1 ~/.local/state/))
	display_diff "$DIFF_OUTPUT"

	section "    .local/share   "
	DIFF_OUTPUT=$(diff <(cat $SHARE_BASELINE) <(/usr/bin/ls -1 ~/.local/share/))
	display_diff "$DIFF_OUTPUT"
else
	if [[ $1 == "update" ]]; then
		if gum confirm "Confirm XDG baseline update"; then
			/usr/bin/ls -1 ~/.config/ > $CONFIG_BASELINE
			/usr/bin/ls -1 ~/.local/state/ > $STATE_BASELINE
			/usr/bin/ls -1 ~/.local/share/ > $SHARE_BASELINE
		fi
	fi
fi
