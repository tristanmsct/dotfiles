#!/usr/bin/env bash
#  ___  ___ _ ____   ____ _ _ __ _ __
# / __|/ _ \ '__\ \ / / _` | '__| '__|
# \__ \  __/ |   \ V / (_| | |  | |
# |___/\___|_|    \_/ \__,_|_|  |_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------
# Wrapper for servarr commands.
# -----------------------------------------------------------------------------------------------------------------------------------------

source "$HOME/.config/shell/lib/format"

script_name=$(basename "$0")
SERVARR_HOME=$HOME/Nextcloud/07-Servarr

show_help() {
    printf "${BOLD}${COLOR_TERM_5}usage:${RESET} ${BOLD}${COLOR_TERM_6}$script_name${RESET}"
    printf " [${COLOR_TERM_3}command${RESET}]\n\n"
    printf "$script_name - A simple wrapper for servarr commands\n\n"
    printf "${BOLD}${COLOR_TERM_5}options:${RESET}\n"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "up" "Start containers"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "down" "Stop containers"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "restart" "Restart containers"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "pull" "Update containers"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "logs" "Print logs for containers"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "shutdown" "Stop containers and docker"
    printf "  ${BOLD}${COLOR_TERM_3}%-20s${RESET} %s\n" "-h, --help" "Display this help message"
    exit 0
}

if [[ -z $1 ]]; then
    if [ -t 1 ]; then
        choice=$(gum choose "up" "down" "restart" "pull" "logs" "shutdown")
    else
        dunstify "Use up, down, restart or shutdown commands"
    fi
else
    choice=$1
fi

if ! systemctl is-active --quiet docker; then
    if [ -t 1 ]; then
        # terminal
        sudo systemctl start docker
    else
        # rofi/drun, no tty
        pkexec systemctl start docker
    fi
    pkill -RTMIN+10 waybar
fi

case $choice in
    up)
        docker compose --file $SERVARR_HOME/compose.yaml up -d ${@:2}
        ;;
    down)
        docker compose --file $SERVARR_HOME/compose.yaml down ${@:2}
        ;;
    restart)
        docker compose --file $SERVARR_HOME/compose.yaml restart ${@:2}
        ;;
    pull)
        docker compose --file $SERVARR_HOME/compose.yaml pull ${@:2}
        ;;
    logs)
        docker compose --file $SERVARR_HOME/compose.yaml logs -f ${@:2}
        ;;
    shutdown)
        docker compose --file $SERVARR_HOME/compose.yaml down
        if [ -t 1 ]; then
            # terminal
            sudo systemctl stop docker.socket
        else
            # rofi/drun, no tty
            pkexec systemctl stop docker.socket
        fi
        pkill -RTMIN+10 waybar
        ;;
    -h|--help)
        show_help
        ;;
    *)
        echo "Unknown command."
        ;;
esac
