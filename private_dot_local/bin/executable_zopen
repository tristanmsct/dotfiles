#!/usr/bin/env bash
#
#  _______  _ __   ___ _ __
# |_  / _ \| '_ \ / _ \ '_ \
#  / / (_) | |_) |  __/ | | |
# /___\___/| .__/ \___|_| |_|
#          |_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------

if [ $# -eq 0 ]; then
    target="$HOME"
else
    target=$(zoxide query --list | fzf --filter "$@" | head -1 2>/dev/null)
    if [ -z "$target" ]; then
        target="$HOME"
    fi
fi
xdg-open "$target" > /dev/null 2>&1 & disown
