#!/usr/bin/env bash
#                _ _
#   ___ ___   __| (_)_   _ _ __ ___
#  / __/ _ \ / _` | | | | | '_ ` _ \
# | (_| (_) | (_| | | |_| | | | | | |
#  \___\___/ \__,_|_|\__,_|_| |_| |_|
#
# -----------------------------------------------------------------------------------------------------------------------------------------
# > [!Important] VScodium is an Electron app, it needs to use brave's fake home otherwise it creates a $HOME/.pki directory.
# -----------------------------------------------------------------------------------------------------------------------------------------

# Get XDG variables and create the fake home if it does not exists.
source "$DESKTOP_SCRIPTS/system/setup-fake-home.sh"

HOME="$FAKE_HOME" VSCODE_PORTABLE="$XDG_DATA_HOME/VSCodium" VSCODE_CLI_DATA_DIR="$XDG_DATA_HOME/VSCodium/cli" exec /usr/bin/codium "$@"
